<Project Sdk="Microsoft.NET.Sdk">

  <!-- Deliberately references nothing. The surface is read out of KSArmory.dll's own metadata
       tables, so this tool builds and runs without KSA's assemblies present - which means CI can
       regenerate the surface on a machine that has no access to the private repository. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>apisurface</AssemblyName>
    <RootNamespace>ApiSurface</RootNamespace>
  </PropertyGroup>

</Project>
