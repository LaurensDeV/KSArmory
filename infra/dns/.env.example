# Copy to .env (gitignored, mode 600) and fill in:
#   set -a && source .env && set +a
#
# The Cloudflare token needs Zone:Read and DNS:Edit, scoped to this zone only, and Pages:Edit on the account.
# Create it at My Profile -> API Tokens -> Create Token -> Edit zone DNS.

export TF_VAR_cloudflare_api_token=
export TF_VAR_zone_id=

# The machine Caddy runs on.
export TF_VAR_vps_ipv4=
export TF_VAR_vps_ipv6=

# The site's Pages project: the account ID in the sidebar of the account's home page. The token above also
# needs Account -> Cloudflare Pages -> Edit for it.
export TF_VAR_account_id=
