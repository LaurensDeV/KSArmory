# Copy to .env (gitignored, mode 600) and fill in:
#   set -a && source .env && set +a

# Immutable digest published by the Feedback image workflow.
export TF_VAR_feedback_image=

# A GitHub username and a token with read:packages, to pull it.
export TF_VAR_ghcr_username=
export TF_VAR_ghcr_token=

# Fine-grained PAT with Issues:write on LaurensDeV/KSArmory alone. Without it the endpoint
# accepts reports and answers 503, because it cannot file them.
export TF_VAR_github_token=
