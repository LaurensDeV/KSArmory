  <PartGameData Id="KSArmory_Prefab_Rail" DisplayName="Weapons Pylon (14-inch rail)">
    <!-- Weapons rather than Structural: it is carriage gear, and it belongs beside the stores it
         carries rather than next to girders. Both tags carry FaceSnapTargetWhitelist, which is
         what the comment below depends on. -->
    <EditorTag Value="Weapons" />
    <EditorTag Value="NoFaceSnapping" />
    <Diameter M="0.4" />

    <!--
      No `Radial` tag, and that is the point of this part rather than an omission. Core's `Radial`
      is a FaceSnapTargetBlacklist, and the blacklist beats the whitelist in HandleSnapping — so a
      part carrying it silently cannot have anything mounted on it. A rail nothing can be mounted
      on is a decoration. What makes it attach radially is the ToSurface connector below, which is
      a different mechanism and unaffected. See docs/KSA-MODDING-NOTES.md.
    -->
    <Connector Id="_rlConnectorBase">
      <Flags>ToSurface</Flags>
    </Connector>
    <Connector Id="_rlConnectorStore" />

    <!-- An empty 14-inch rail is a few tens of kilogrammes of alloy. -->
    <SolidSphereMass>
      <Mass Kg="42" />
      <Radius M="0.25" />
    </SolidSphereMass>

    <!--
      Straight off the _ColPrim_KSArmory_Rail_Body node in the atlas: a unit box scaled to
      (0.22006, 0.81257, 0.30768) and offset to (0.11003, 0, 0). Read rather than eyeballed, so
      the collider is the one the model was authored with.
    -->
    <Collider Id="KSArmory_RailCollider">
      <Box Id="KSArmory_RailBodyCollider">
        <LocationAsmb X="0.11003" Y="0" Z="0" />
        <Collider2Asmb X="0" Y="0" Z="0" />
        <LengthX M="0.22006" />
        <LengthY M="0.81257" />
        <LengthZ M="0.30768" />
