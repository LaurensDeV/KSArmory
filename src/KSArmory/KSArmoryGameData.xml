<?xml version="1.0" encoding="utf-8" ?>
<!--
  Simulation definition of the Pantsir-S1 point-defence launcher.

  Deliberately inert as far as KSA is concerned: mass, colliders and an attach node, nothing
  more. All the behaviour lives in the C# mod, which looks for a part with this Id on the
  vehicle and mounts the battery there. That split avoids having to register a custom module
  type into the engine's internal update lists, which is not reachable without patching.

  Collider boxes are axis-aligned in part space: X up, Y along the vehicle, Z across it. The
  hull box starts at X = 0 so the vehicle rests on its wheels rather than sinking to its
  chassis rails.
-->
<Assets>

  <!--
    Its own category in the part picker, rather than filed under Structural where a Phalanx mount
    sits next to girders. EditorTag is a string rather than an enum and the picker draws a row per
    registered tag, so this is a supported extension: Core's own CoreEditorTagsGameData.xml says
    so in a comment addressed to modders.

    The three flags are copied from Structural and are not decoration. Structural carries
    RootPartWhitelist, FaceSnapTargetWhitelist and DiameterFilterlist, and moving a part off it
    without them silently drops the launcher's ability to be a craft's root part, stops anything
    face-snapping to it, and removes it from diameter filtering. None of that fails loudly.

    Named for the job rather than for this mod on purpose. The lookup is keyed on the string, so a
    second weapons mod declaring "Weapons" shares this tab instead of adding a near-duplicate.
    There is no way to filter within a tab by mod or manufacturer; docs/BLOCKED-ON-KSA.md has why.
  -->
  <EditorTagDef Id="Weapons" RootPartWhitelist="true" FaceSnapTargetWhitelist="true"
                DiameterFilterlist="true" />

  <PartGameData Id="KSArmory_Prefab_Launcher6" DisplayName="Pantsir-S1 Point Defence System">
    <EditorTag Value="Weapons" />
    <EditorTag Value="Radial" />
    <EditorTag Value="NoFaceSnapping" />
    <Diameter M="3" />

    <!-- Attaches by its underside to the top or side of a stack. -->
    <Connector Id="_adConnectorAft">
      <Flags>ToSurface</Flags>
    </Connector>

    <!--
      Makes the launcher a command source in its own right, so it can be the root of a
      vehicle and launched on its own as a self-contained air-defence site. Without this a
      craft consisting only of the launcher has nothing to control it and KSA will not fly it.
      It still surface-attaches to a larger craft exactly as before.
    -->
    <Control />

    <!-- Onboard cell, so the unit is not dead weight when detached from a host craft. -->
    <Battery>
      <MaximumCapacity J="2000" />
    </Battery>

    <!-- Combat weight of a real Pantsir-S1 on its KAMAZ-6560: about thirty tonnes. -->
    <SolidSphereMass>
      <Mass Kg="30000" />
      <Radius M="2.00" />
    </SolidSphereMass>

    <Collider Id="KSArmory_Collider">
      <!-- Chassis and running gear, resting on the ground plane at X = 0. -->
      <Box Id="KSArmory_HullCollider">
        <LocationAsmb X="1.03" Y="0.05" Z="0" />
        <Collider2Asmb X="0" Y="0" Z="0" />
        <LengthX M="2.06" />
        <LengthY M="7.98" />
        <LengthZ M="2.96" />
      </Box>
      <!-- Cab. -->
      <Box Id="KSArmory_CabCollider">
        <LocationAsmb X="2.55" Y="2.77" Z="0" />
        <Collider2Asmb X="0" Y="0" Z="0" />
        <LengthX M="1.00" />
        <LengthY M="2.18" />
        <LengthZ M="2.60" />
      </Box>
      <!-- Turret body. -->
      <Box Id="KSArmory_TurretCollider">
        <LocationAsmb X="2.75" Y="-1.42" Z="0" />
        <Collider2Asmb X="0" Y="0" Z="0" />
        <LengthX M="1.40" />
        <LengthY M="3.20" />
        <LengthZ M="2.50" />
      </Box>
      <!-- Elevated missile pods and the search radar above them. -->
      <Box Id="KSArmory_PodCollider">
        <LocationAsmb X="4.30" Y="-0.90" Z="0" />
        <Collider2Asmb X="0" Y="0" Z="0" />
        <LengthX M="2.70" />
        <LengthY M="2.60" />
        <LengthZ M="2.90" />
      </Box>
    </Collider>
  </PartGameData>

  <PartGameData Id="KSArmory_Prefab_BombRack" DisplayName="Mk 82 Bomb Rack">
    <EditorTag Value="Weapons" />
    <EditorTag Value="Radial" />
    <EditorTag Value="NoFaceSnapping" />
    <Diameter M="0.5" />

    <!-- Attaches by the pylon's base to the side of a stack. -->
    <Connector Id="_brConnectorBase">
      <Flags>ToSurface</Flags>
    </Connector>

    <!-- Mk 82 at 227 kg on a 45 kg rack and its pylon. -->
    <SolidSphereMass>
      <Mass Kg="272" />
      <Radius M="0.70" />
    </SolidSphereMass>

    <Collider Id="KSArmory_RackCollider">
      <!-- Rack and pylon, standing off the mounting face at X = 0. -->
      <Box Id="KSArmory_RackBeamCollider">
        <LocationAsmb X="0.15" Y="0.02" Z="0" />
        <Collider2Asmb X="0" Y="0" Z="0" />
        <LengthX M="0.30" />
        <LengthY M="1.30" />
        <LengthZ M="0.24" />
      </Box>
      <!-- The bomb on it. -->
      <Box Id="KSArmory_RackRoundCollider">
        <LocationAsmb X="0.41" Y="0" Z="0" />
        <Collider2Asmb X="0" Y="0" Z="0" />
        <LengthX M="0.30" />
        <LengthY M="2.26" />
        <LengthZ M="0.30" />
      </Box>
    </Collider>
  </PartGameData>

  <PartGameData Id="KSArmory_Prefab_SidewinderRail" DisplayName="LAU-7 Sidewinder Rail">
    <EditorTag Value="Weapons" />
    <EditorTag Value="Radial" />
    <EditorTag Value="NoFaceSnapping" />
    <Diameter M="0.5" />

    <!-- Attaches by the pylon's base to the side of a stack. -->
    <Connector Id="_swConnectorBase">
      <Flags>ToSurface</Flags>
    </Connector>

    <!--
      No <Control>, unlike the Pantsir: a rail is not a vehicle and has nothing to fly itself
      with. It bolts to a craft that already has a command source.
    -->

    <!-- AIM-9J at 78 kg on a LAU-7 rail and its pylon. -->
    <SolidSphereMass>
      <Mass Kg="120" />
      <Radius M="0.80" />
    </SolidSphereMass>

    <Collider Id="KSArmory_RailCollider">
      <!-- Rail and pylon, standing off the mounting face at X = 0. -->
      <Box Id="KSArmory_RailBeamCollider">
        <LocationAsmb X="0.18" Y="0.03" Z="0" />
        <Collider2Asmb X="0" Y="0" Z="0" />
        <LengthX M="0.36" />
        <LengthY M="2.56" />
        <LengthZ M="0.22" />
      </Box>
      <!-- The round on it. -->
      <Box Id="KSArmory_RailRoundCollider">
        <LocationAsmb X="0.41" Y="0" Z="0" />
        <Collider2Asmb X="0" Y="0" Z="0" />
        <LengthX M="0.34" />
        <LengthY M="3.09" />
        <LengthZ M="0.34" />
      </Box>
    </Collider>
  </PartGameData>

  <PartGameData Id="KSArmory_Prefab_Optic" DisplayName="EO Director">
    <EditorTag Value="Weapons" />
    <EditorTag Value="Radial" />
    <EditorTag Value="NoFaceSnapping" />
    <Diameter M="0.6" />

    <!-- Attaches by the flange's underside to the side or top of a stack. -->
    <Connector Id="_opConnectorBase">
      <Flags>ToSurface</Flags>
    </Connector>

    <!--
      No <Control>, unlike the Pantsir: a sight is not a vehicle. It bolts to a craft that
      already has a command source, or to one that never flies.
    -->

    <!-- A naval EO director of this size is a couple of hundred kilogrammes with its mount. -->
    <SolidSphereMass>
      <Mass Kg="180" />
      <Radius M="0.40" />
    </SolidSphereMass>

    <Collider Id="KSArmory_OpticCollider">
      <!-- Flange and mast, standing off the mounting face at X = 0. -->
      <Box Id="KSArmory_OpticMastCollider">
        <LocationAsmb X="0.22" Y="0" Z="0" />
        <Collider2Asmb X="0" Y="0" Z="0" />
        <LengthX M="0.44" />
        <LengthY M="0.60" />
        <LengthZ M="0.60" />
      </Box>
      <!-- The head, at every elevation it can reach. -->
      <Box Id="KSArmory_OpticHeadCollider">
        <LocationAsmb X="0.63" Y="0" Z="0" />
        <Collider2Asmb X="0" Y="0" Z="0" />
        <LengthX M="0.43" />
        <LengthY M="0.47" />
        <LengthZ M="0.43" />
      </Box>
    </Collider>
  </PartGameData>

  <PartGameData Id="KSArmory_Prefab_Ciws" DisplayName="Mk 15 Phalanx CIWS">
    <EditorTag Value="Weapons" />
    <Diameter M="3" />

    <!--
      No Radial or NoFaceSnapping tag and no ToSurface flag on the connector: this part STACKS.
      It mates with the top node of any 3 m tank, decoupler or adapter.
    -->
    <Connector Id="_ciwsConnectorBase" />

    <!-- A Mk 15 is about 6.2 tonnes with a full magazine. -->
    <SolidSphereMass>
      <Mass Kg="6200" />
      <Radius M="1.20" />
    </SolidSphereMass>

    <Collider Id="KSArmory_CiwsCollider">
      <!-- Flange and pedestal, resting on the mounting face at X = 0. -->
      <Box Id="KSArmory_CiwsBaseCollider">
        <LocationAsmb X="0.34" Y="0" Z="0" />
        <Collider2Asmb X="0" Y="0" Z="0" />
        <LengthX M="0.70" />
        <LengthY M="2.80" />
        <LengthZ M="2.80" />
      </Box>
      <!-- The traversing housing. -->
      <Box Id="KSArmory_CiwsHousingCollider">
        <LocationAsmb X="1.53" Y="0" Z="0" />
        <Collider2Asmb X="0" Y="0" Z="0" />
        <LengthX M="1.90" />
        <LengthY M="1.95" />
        <LengthZ M="1.95" />
      </Box>
      <!-- Radome. -->
      <Box Id="KSArmory_CiwsRadomeCollider">
        <LocationAsmb X="3.64" Y="0" Z="0" />
        <Collider2Asmb X="0" Y="0" Z="0" />
        <LengthX M="2.20" />
        <LengthY M="1.62" />
        <LengthZ M="1.62" />
      </Box>
    </Collider>
  </PartGameData>

</Assets>
