<?xml version="1.0" encoding="utf-8" ?>
<!--
  Simulation definitions of the mod's parts.

  Deliberately inert as far as KSA is concerned: mass, colliders and connectors, plus the bus's
  engine, nozzles and tank. All the weapon behaviour lives in the C# mod, which looks for a part with
  a registered Id on the vehicle and mounts a weapons system there. That split avoids having to
  register a custom module type into the engine's internal update lists, which is not reachable
  without patching.

  Collider boxes are axis-aligned in part space: X up out of the mounting face, Y along the part, Z
  across it. The Pantsir's hull box starts at X = 0 so the vehicle rests on its wheels rather than
  sinking to its chassis rails.
-->
<Assets>

  <!--
    Its own category in the part picker, rather than Structural. A mod may declare tags; Core's
    CoreEditorTagsGameData.xml says so.

    The three flags are Structural's, and a part off Structural without them silently cannot be a
    craft's root, cannot be face-snapped to, and is left out of diameter filtering.

    Named for the job rather than for this mod: the lookup is keyed on the string, so a second weapons
    mod declaring "Weapons" shares this tab. docs/BLOCKED-ON-KSA.md has why a tab cannot be filtered
    by mod.
  -->
  <EditorTagDef Id="Weapons" RootPartWhitelist="true" FaceSnapTargetWhitelist="true"
                DiameterFilterlist="true" />

  <!--
    Beside Weapons rather than inside it, because a sensor is useful on a craft with no armament.

    Same three flags. RootPartWhitelist does nothing for a part with a ToSurface connector, which the
    editor never lets start a craft whatever its tags say; it is here for a sensor that stacks.
  -->
  <EditorTagDef Id="Sensors" RootPartWhitelist="true" FaceSnapTargetWhitelist="true"
                DiameterFilterlist="true" />

  <PartGameData Id="KSArmory_Prefab_Launcher6" DisplayName="Pantsir-S1 Point Defence System">
    <EditorTag Value="Weapons" />

    <!--
      Not Radial, unlike the stores below. That tag is on the editor's face-snap target
      *blacklist*, and the blacklist beats the Weapons whitelist, so with it nothing could be
      mounted on the launcher, an EO director included.
    -->
    <EditorTag Value="NoFaceSnapping" />
    <Diameter M="3" />

    <!--
      A node connector, at the part origin, which is the underside. No ToSurface, and that is
      what lets the launcher start a craft: VehicleEditor.IsAllowedAsRootPart rejects a part if
      *any* of its connectors is ToSurface or FromSurface, whatever tags it carries. So a vehicle
      root and a radially-attached part are mutually exclusive in KSA, and this is a truck.

      NoFaceSnapping above is the other half. Face snapping is a separate route onto a surface
      that a ToSurface connector suppresses, so dropping the flag would otherwise switch this
      part onto it, and it aligns the part's -Z to the surface where the connector path aligns
      the connector's -X. +X is up on this hull, so that lays an 8x8 truck on its side.
    -->
    <Connector Id="_adConnectorAft" />

    <!--
      Makes the launcher a command source in its own right, so a craft that is only this has
      something to control it. Without it KSA will not fly one.
    -->
    <Control />

    <!-- Onboard cell, so the unit is not dead weight when detached from a host craft. -->
    <Battery>
      <MaximumCapacity J="2000" />
    </Battery>

    <!-- Combat weight of a real Pantsir-S1 on its KAMAZ-6560: about thirty tonnes. -->
    <SolidSphereMass>
      <Mass Kg="30000" />
      <Radius M="2.00" />
    </SolidSphereMass>

    <Collider Id="KSArmory_Collider">
      <!-- Chassis and running gear, resting on the ground plane at X = 0. -->
      <Box Id="KSArmory_HullCollider">
        <LocationAsmb X="1.03" Y="0.05" Z="0" />
        <Collider2Asmb X="0" Y="0" Z="0" />
        <LengthX M="2.06" />
        <LengthY M="7.98" />
        <LengthZ M="2.96" />
      </Box>
      <!-- Cab. -->
      <Box Id="KSArmory_CabCollider">
        <LocationAsmb X="2.55" Y="2.77" Z="0" />
        <Collider2Asmb X="0" Y="0" Z="0" />
        <LengthX M="1.00" />
        <LengthY M="2.18" />
        <LengthZ M="2.60" />
      </Box>
      <!-- Turret body. -->
      <Box Id="KSArmory_TurretCollider">
        <LocationAsmb X="2.75" Y="-1.42" Z="0" />
        <Collider2Asmb X="0" Y="0" Z="0" />
        <LengthX M="1.40" />
        <LengthY M="3.20" />
        <LengthZ M="2.50" />
      </Box>
      <!-- Elevated missile pods and the search radar above them. -->
      <Box Id="KSArmory_PodCollider">
        <LocationAsmb X="4.30" Y="-0.90" Z="0" />
        <Collider2Asmb X="0" Y="0" Z="0" />
        <LengthX M="2.70" />
        <LengthY M="2.60" />
        <LengthZ M="2.90" />
      </Box>
    </Collider>
  </PartGameData>

