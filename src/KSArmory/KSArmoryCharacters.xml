<?xml version="1.0" encoding="utf-8"?>
<!--
  One <Character>, and every piece of it is Core's: the body, the fur, every animation set,
  referenced by Id. If Core renames one of these, this file breaks loudly at load rather than
  quietly rendering a kitten with no head.

  It exists only so that saves naming it keep loading - see the note on the Character itself.
  ModLibrary.AllCharacters is what KittenRosterData.PickRandomCharacterId draws from, so a kitten
  on the roster can still come up wearing this one; it is a stock kitten either way.
-->
<Assets>

    <!--
      A stock kitten under a name of this mod's own, carrying nothing.

      Kept rather than deleted because a save records the character its kitten wore, and
      KittenEva.CreateKittenFromSaveData resolves that Id through ModLibrary.Get, which throws
      NullReferenceException when it is missing. That runs inside UncompressedSave.Load under
      Popup.DrawAll, where nothing catches it, so removing this Id terminates the game on every
      save whose kitten is wearing it. Renaming is the same thing.
    -->
    <Character Id="KSArmoryArmedKitten">
        <Personality Value="Neutral"/>
        <CharacterCore Id="CharacterCore"/>
        <CharacterTextures Id="CharacterTextures"/>

        <CharacterHelmet Id="CharacterHelmetAttachment"/>
        <CharacterVisor Id="CharacterVisorAttachment"/>
        <CharacterMMU Id="CharacterMMUAttachment"/>


        <CharacterFur Id="CharacterFur"/>
        <CharacterExpressions Id="CharacterExpressions"/>
        <CharacterMMUAnimations Id="CharacterMMUAnimations"/>
        <CharacterAnimationMasks Id="CharacterAnimationMasks"/>
        <CharacterGroundAnimations Id="CharacterGroundAnimations"/>

        <AnimHelmetMask Id="KittenAnimHelmetMaskGlb"/>
        <BlinkAnim Id="KSA_Cat_Anim_BlinkGlb"/>
    </Character>

</Assets>
