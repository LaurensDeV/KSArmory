        <Position X="-4.00000" Y="0.00000" Z="0.00000" />
        <Scale X="0.00100" Y="0.00100" Z="0.00100" />
      </Transform>
    </SubPart>


    <!-- Fin sets, one per round. Modelled about the same origin as the round body so they can
         share its transform, and scaled radially by the mod: flat against the casing while
         stowed in the tube, flicked out to full span once the round is clear. -->
    <SubPart Id="AirDefence_Launcher_Fins00" InstanceOf="AirDefence_Subpart_Fins">
      <Transform>
        <Position X="-4.00000" Y="0.00000" Z="0.00000" />
        <Scale X="0.00100" Y="0.00100" Z="0.00100" />
