    </PartModel>
    <MeshView>
      <Mesh Id="KSArmory_Subpart_Guns_VM" />
    </MeshView>
  </SubPart>

  <!-- Twelve missile containers in two pods. Elevates on the turret's trunnions. -->
  <SubPart Id="KSArmory_Pods_SubPart">
    <PartModel Id="KSArmory_Subpart_Pods_Model">
      <Mesh Id="KSArmory_Subpart_Pods" />
      <Material Id="KSArmory_Material" />
    </PartModel>
    <MeshView>
      <Mesh Id="KSArmory_Subpart_Pods_VM" />
    </MeshView>
  </SubPart>

  <Part Id="KSArmory_Prefab_Launcher6">

    <SubPart Id="KSArmory_Launcher_Chassis" InstanceOf="KSArmory_Chassis_SubPart" />

    <!--
      The turret mesh is exported centred on its slew axis, so this puts it back on the deck.
      KSA rotates a subpart about its own origin; without that recentring, writing the turret's
      Asmb2ParentAsmb each frame would swing it around the chassis rather than spin it in place.
      Keep this in step with TURRET_PIVOT in tools/model/pantsir.py.
    -->
    <SubPart Id="KSArmory_Launcher_Turret" InstanceOf="KSArmory_Turret_SubPart">
      <Transform>
        <Position X="0.00000" Y="-1.42000" Z="0.00000" />
      </Transform>
    </SubPart>

    <!--
      Missile pods, on the turret's trunnions. A sibling of the turret rather than a child of
      it - SubParts are placed against the Part and do not nest - so the mod composes traverse
      and elevation itself and rewrites this position every frame as the turret swings. The
      value here is only the rest pose, with the turret facing forward.
      Keep in step with POD_PIVOT in tools/model/pantsir.py.
    -->
    <SubPart Id="KSArmory_Launcher_Pods" InstanceOf="KSArmory_Pods_SubPart">
      <Transform>
        <Position X="2.62000" Y="-2.05000" Z="0.00000" />
      </Transform>
    </SubPart>

    <!--
      Cannon. Pitch about their own trunnion while riding the turret, so like the pods they get
      both rotation and position rewritten every frame.
      Keep in step with GUN_PIVOT in tools/model/pantsir.py.
    -->
    <SubPart Id="KSArmory_Launcher_Guns" InstanceOf="KSArmory_Guns_SubPart">
      <Transform>
        <Position X="3.70000" Y="-1.35000" Z="0.00000" />
      </Transform>
    </SubPart>

    <!--
      Search array. Turns continuously about its own vertical axis while riding the turret,
      so like the pods it gets both its rotation and its position rewritten every frame.
      Keep in step with RADAR_PIVOT in tools/model/pantsir.py.
    -->
    <SubPart Id="KSArmory_Launcher_Radar" InstanceOf="KSArmory_Radar_SubPart">
      <Transform>
        <Position X="4.05000" Y="-2.52000" Z="0.00000" />
      </Transform>
    </SubPart>

    <!--
      Electro-optical head. Aimed freely rather than about an axis, so the mod writes it a full
      rotation each frame; the value here is only where its ball sits with the turret forward.
      Keep in step with EO_PIVOT in tools/model/pantsir.py.
    -->
    <SubPart Id="KSArmory_Launcher_Optic" InstanceOf="KSArmory_Optic_SubPart">
      <Transform>
        <Position X="4.10000" Y="-0.35000" Z="0.44000" />
      </Transform>
    </SubPart>

    <!-- Underside attach node, at the ground plane and facing down. -->
    <Connector Id="_adConnectorAft">
      <Transform>
        <Position X="0.00000" />
        <Rotation Z="3.14159" />
        <Scale X="3.00000" Y="3.00000" Z="3.00000" />
      </Transform>
    </Connector>


    <!-- Twelve rounds, parked below the vehicle and shrunk away until fired. -->
    <SubPart Id="KSArmory_Launcher_Missile00" InstanceOf="KSArmory_Missile_SubPart">
