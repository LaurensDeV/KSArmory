  <!-- Twin 30 mm cannon, one each side. Pitch on their own trunnion, outboard of the pods. -->
  <SubPart Id="KSArmory_Guns_SubPart">
    <PartModel Id="KSArmory_Subpart_Guns_Model">
      <Mesh Id="KSArmory_Subpart_Guns" />
