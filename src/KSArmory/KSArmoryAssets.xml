        <Position X="-4.00000" Y="0.00000" Z="0.00000" />
        <Scale X="0.00100" Y="0.00100" Z="0.00100" />
      </Transform>
    </SubPart>
    <SubPart Id="KSArmory_Launcher_Missile06" InstanceOf="KSArmory_Missile_SubPart">
