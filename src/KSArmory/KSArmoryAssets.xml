<!--
  Visual definition of the Pantsir-S1 point-defence launcher.

  The mod ships its own art: a mesh atlas and a small palette texture set, built by
  tools/model/build.sh. The structure below mirrors Core's own asset files exactly - atlas,
  material, subparts, part - because that is the known-good shape for a KSA content mod.

  This file lives at the mod root rather than in a subfolder on purpose. <MeshAtlas Path> and
  the texture paths are relative, and it is not documented whether they resolve against the
  mod root or against this file's own directory. With the XML at the root both readings give
  the same answer, so the question never has to be settled.

  Geometry, from tools/meshinfo.py on the exported atlas:
    KSArmory_Subpart_Chassis   3.100 x 8.030 x 3.220   centre (+1.550, +0.075, 0)
    KSArmory_Subpart_Turret    3.618 x 4.334 x 3.215   centre (+3.829, -0.993, 0)

  Both meshes carry their final part-space coordinates - no <Transform> here. X is the part's
  forward axis and the battery's boresight, so it is the vehicle's *up*; +Y is the direction
  it drives and +Z is its right side. The origin sits on the ground between the wheels.

  Chassis and turret are separate subparts so the turret can later be split into a part of its
  own and slewed onto the locked track. See the Pantsir brief in CLAUDE.md.
-->
<Assets>

  <MeshAtlas Path="Meshes/KSArmory_MeshAtlas.glb" />

  <!--
    A SubPart's Id must not be a mesh's Id. The atlas registers every mesh under its glTF node
    name, so declaring a SubPart under that same name registers two different assets against one
    Id and the loader keeps whichever it saw first. It loaded and ran anyway; what caught it was
    SpaceDock's importer, warning KSAM-0602. Hence KSArmory_<name>_SubPart against the atlas's
    KSArmory_Subpart_<name>, which is the same split Core uses - LightSubPart against
    LightPartMesh. validate-parts.py fails if the two namespaces ever touch again.
  -->

  <!--
    One material for the whole vehicle. Every face is UV-mapped to the centre of a flat swatch
    in a 4x4 palette, so surface variety comes from UVs rather than from painted texels - see
    tools/model/palette.py. AoRoughMetal is R=occlusion, G=roughness, B=metalness, matching the
    element name, the glTF ORM convention, and Core's own default_pbr.png of (255, 180, 0).
  -->
  <PbrMaterial Id="KSArmory_Material">
    <Diffuse Path="Textures/KSArmory_Diffuse.png" Category="Vessel" />
    <Normal Path="Textures/KSArmory_Normal.png" Category="Vessel" />
    <AoRoughMetal Path="Textures/KSArmory_PBR.png" Category="Vessel" />
  </PbrMaterial>

  <!-- KAMAZ-6560 8x8 chassis: wheels, hull, deck, cab, stowage. -->
  <SubPart Id="KSArmory_Chassis_SubPart">
    <PartModel Id="KSArmory_Subpart_Chassis_Model">
      <Mesh Id="KSArmory_Subpart_Chassis" />
      <Material Id="KSArmory_Material" />
    </PartModel>
    <MeshView>
      <Mesh Id="KSArmory_Subpart_Chassis_VM" />
    </MeshView>
  </SubPart>

  <!-- Turret: twin 30 mm cannon, tracking array, search radar, trunnions. Traverses. -->
  <SubPart Id="KSArmory_Turret_SubPart">
    <PartModel Id="KSArmory_Subpart_Turret_Model">
      <Mesh Id="KSArmory_Subpart_Turret" />
      <Material Id="KSArmory_Material" />
    </PartModel>
    <MeshView>
      <Mesh Id="KSArmory_Subpart_Turret_VM" />
    </MeshView>
  </SubPart>

  <!--
    The round itself, instanced once per tube. These are hidden (scaled to nothing) until the
    mod puts one in the air, at which point it writes the body's position and orientation every
    frame from the round it is simulating. Twelve of them so a full salvo can be in flight.
  -->
  <SubPart Id="KSArmory_Missile_SubPart">
    <PartModel Id="KSArmory_Subpart_Missile_Model">
      <Mesh Id="KSArmory_Subpart_Missile" />
      <Material Id="KSArmory_Material" />
    </PartModel>
    <MeshView>
      <Mesh Id="KSArmory_Subpart_Missile_VM" />
    </MeshView>
  </SubPart>

    <!--
      The round's fins, a template of their own so the mod can scale them independently of the
      body: flat against the casing while stowed in the tube, flicked out to full span once the
      round is away. Modelled about the same origin as the body, so the two share a transform.

      This template must exist even though nothing instances it directly - the SubPart entries
      further down name it with InstanceOf, and without it the game throws
      "PartTemplate is null for 'KSArmory_Fins_SubPart'" and takes the session with it.
    -->
    <SubPart Id="KSArmory_Fins_SubPart">
      <PartModel Id="KSArmory_Subpart_Fins_Model">
        <Mesh Id="KSArmory_Subpart_Fins" />
        <Material Id="KSArmory_Material" />
      </PartModel>
      <MeshView>
        <Mesh Id="KSArmory_Subpart_Fins_VM" />
      </MeshView>
    </SubPart>

  <!-- Phalanx-pattern CIWS. Base is fixed; the housing traverses and the guns elevate on it. -->
  <SubPart Id="KSArmory_CiwsBase_SubPart">
    <PartModel Id="KSArmory_Subpart_CiwsBase_Model">
      <Mesh Id="KSArmory_Subpart_CiwsBase" />
