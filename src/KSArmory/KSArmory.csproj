<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>KSArmory</RootNamespace>
    <!-- StarMap loads "<EntryAssembly>.dll" from mod.toml, so this name must match it. -->
    <AssemblyName>KSArmory</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <!-- Stamped into the assembly and used to name the release archive. -->
    <Version>0.8.31</Version>
  </PropertyGroup>

  <!--
    Release ships no debug information at all: no .pdb beside the DLL, and no embedded
    sequence points. A mod is a single file dropped into someone's game folder, and a stack
    trace with line numbers is worth nothing to them without the matching source.

    Debug keeps everything, and Log defaults to its Debug threshold there - see Ksa/Log.cs.
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Optimize>true</Optimize>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <None Update="mod.toml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <!-- Part definitions, listed in mod.toml's assets array. -->
    <None Update="KSArmory*.xml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <!-- The launcher's art. Regenerate with tools/model/build.sh; both are committed so a
         plain build does not need Blender. -->
    <None Update="Meshes\**\*.glb">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Textures\**\*.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!--
    Game and loader assemblies are compile-time only. They are already loaded in the KSA
    process, so Private=false keeps them (and everything KSA.dll drags in transitively) out
    of the mod output - shipping a second copy would be loaded into a different
    AssemblyLoadContext and the type identities would not match the running game's.

    $(KsaDllDir) is resolved by Directory.Build.props at the repository root: an explicit
    KSA_DLL_DIR, then Import/, then a sibling ksa-game-assemblies checkout, then the game
    install. Populate Import/ with tools/sync-import.sh, or let one of the other tiers answer.
  -->
  <ItemGroup>
    <Reference Include="$(KsaDllDir)KSA.dll" Private="false" />
    <Reference Include="$(KsaDllDir)StarMap.API.dll" Private="false" />
    <Reference Include="$(KsaDllDir)Brutal.Core.Numerics.dll" Private="false" />
    <Reference Include="$(KsaDllDir)Brutal.Core.Common.dll" Private="false" />
    <Reference Include="$(KsaDllDir)Brutal.Core.Strings.dll" Private="false" />
    <Reference Include="$(KsaDllDir)Brutal.ImGui.dll" Private="false" />
    <Reference Include="$(KsaDllDir)Brutal.ImGui.Abstractions.dll" Private="false" />
    <!--
      JobScheduler, for KsaWorld.WaitForVehicleSolvers. Destroying a vehicle removes it from the
      list KSA's solver jobs are enumerating on worker threads, and no mod hook lands in the window
      where those are idle - so the barrier has to be taken explicitly. See KsaWorld.
    -->
    <Reference Include="$(KsaDllDir)Brutal.Concurrency.dll" Private="false" />
    <!-- Needed to compile against Vehicle's mass-properties signatures (Symmetric3x3). -->
    <Reference Include="$(KsaDllDir)BepuUtilities.dll" Private="false" />
  </ItemGroup>

  <!--
    The KSA build this was compiled against, taken from ksa-assemblies.lock rather than written
    down a second time. The panel compares it to the build actually running.
  -->
  <PropertyGroup>
    <KsaLockPath>$(MSBuildThisFileDirectory)../../ksa-assemblies.lock</KsaLockPath>
    <KsaBuildLine Condition="Exists('$(KsaLockPath)')">$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(KsaLockPath)')), 'build[ \t]+[0-9][^\r\n]*').Value)</KsaBuildLine>
    <KsaBuild Condition="'$(KsaBuildLine)' != ''">$(KsaBuildLine.Substring(6).Trim())</KsaBuild>
  </PropertyGroup>

  <ItemGroup Condition="'$(KsaBuild)' != ''">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>KsaBuild</_Parameter1>
      <_Parameter2>$(KsaBuild)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
