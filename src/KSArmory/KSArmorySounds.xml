<?xml version="1.0" encoding="utf-8"?>
<!--
  The mod's own sounds. Modelled on Core's Sounds.xml, which is the only documentation this format
  has.

  The .wav files beside this are GENERATED by tools/sounds.py, not recorded or downloaded. That is
  a licensing decision as much as a workflow one: a sampled explosion carries terms that have to
  travel with the release archive, and this repository is MIT throughout. It is also the only way
  the sound can be re-cut - a script takes a parameter, a .wav does not.

  Three variants, and the <Sound> picks between them. One sample repeated is what makes a cannon
  burst sound synthetic, and twelve missiles arriving is exactly when that would show.

  Mono on purpose. The engine spatialises the source, and a stereo file has nothing to spatialise:
  it arrives already mixed and sits in the listener's head.
-->
<Assets>

    <!--
      Fully positional, unlike the Decouple charge this replaced. Core plays that through
      InterfaceSfxSpatialData, whose TwoDFloor of 0.5 keeps half the signal non-directional -
      fine for a UI click, wrong for something happening 4 km away over there.

      VolumeRange Min is where falloff starts, Max where it is gone. 15 km because a warhead going
      off is the loudest thing this mod produces and a distant one should still register.
    -->
    <SpatialSoundData Id="KSArmoryBurstSpatialData">
        <VolumeRange Min="40" Max="15000" />
        <TwoDRange Min="4" Max="18" />
    </SpatialSoundData>

    <Sound Id="KSArmoryBurst" ChannelId="ExternalChannel">
        <SoundFile Path="Sounds/KSArmory_Burst00.wav" Volume="1.0"/>
        <SoundFile Path="Sounds/KSArmory_Burst01.wav" Volume="1.0"/>
        <SoundFile Path="Sounds/KSArmory_Burst02.wav" Volume="1.0"/>
        <SpatialSoundData Id="KSArmoryBurstSpatialData" />

        <!-- On top of the per-charge pitch the mod applies, so two identical shells still differ. -->
        <Pitch Min="0.92" Max="1.08" />
    </Sound>


    <!--
      Cyclic cannon fire. Quieter and shorter-ranged than a warhead: a gun is loud where you are
      standing and a detonation is loud from the next county.
    -->
    <SpatialSoundData Id="KSArmoryCannonSpatialData">
        <VolumeRange Min="25" Max="6000" />
        <TwoDRange Min="3" Max="14" />
    </SpatialSoundData>

    <!--
      A burst of gunfire is THREE sounds, and the engine already knows it: the barrels coming up to
      speed, steady fire for as long as the trigger is held, and the reports arriving back off the
      terrain afterwards. One looping sample gets the spin-up on every pass and never gets the
      tail, which is what makes a synthesised loop read as a texture rather than as an event.

      Cut from a recording by tools/cut-cannon.py, whose cut points are measured off the envelope
      rather than typed in. See tools/audio/README.md, which also carries the licence question
      that has to be settled before a release ships these.

      Same shape as Core's DefaultEngineSoundBehavior, which is a CompoundSound for the same
      reason an engine is: it starts, it runs, it stops.
    -->
    <Sound Id="KSArmoryCannonSpin" ChannelId="ExternalChannel">
        <SoundFile Path="Sounds/KSArmory_Cannon_Spin.wav" Volume="1.0"/>
        <SpatialSoundData Id="KSArmoryCannonSpatialData" />
    </Sound>

    <Sound Id="KSArmoryCannonLoop" ChannelId="ExternalChannel">
        <SoundFile Path="Sounds/KSArmory_Cannon_Loop.wav" Volume="1.0">
            <Loop />
        </SoundFile>
        <SpatialSoundData Id="KSArmoryCannonSpatialData" />
    </Sound>

    <Sound Id="KSArmoryCannonTail" ChannelId="ExternalChannel">
        <SoundFile Path="Sounds/KSArmory_Cannon_Tail.wav" Volume="1.0"/>
        <SpatialSoundData Id="KSArmoryCannonSpatialData" />
    </Sound>

    <CompoundSound Id="KSArmoryCannon">
        <StartSound Id="KSArmoryCannonSpin" />
        <Sound Id="KSArmoryCannonLoop" />
        <StopSound Id="KSArmoryCannonTail" />
    </CompoundSound>

</Assets>
