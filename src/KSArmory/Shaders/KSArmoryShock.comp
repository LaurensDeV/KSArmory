#version 450

// The blast front as it is seen on film: not a thing but a bend in the light behind it, a ring
// racing out from the burst. Two dispatches from CloudPass: the first copies the scene, because a
// pass may not read a neighbour of the pixel it is writing, and the second writes each pixel back
// from the copy at an offset where the ray grazes the front's shell -- and, while a front has just
// passed the eye, from wherever the shaken picture puts it.
//
// Bindings follow ComputePipelineWrapper's order: storage images, then the depth it samples.

layout (local_size_x = 8, local_size_y = 8) in;

layout (set = 1, binding = 0, Rgba16f) uniform image2D sceneColor;
layout (set = 1, binding = 1, Rgba16f) uniform image2D sceneCopy;
layout (set = 1, binding = 2) uniform sampler2D sceneDepth;

layout (push_constant) uniform PushConstants
{
    mat4 InvViewProj;       // clip -> camera-relative world
    vec4 CentreRadius;      // the burst, camera-relative, and how far the front has got
    vec4 CentreUvStrength;  // the burst on screen, how hard the front bends light, its thickness
    vec4 UpMode;            // the local vertical at the burst, one plus its height over the ground long, and 0 to copy or 1 to bend
    vec4 Shake;             // across and up in shares of the height, a roll in radians, 1 while shaking
} pc;

vec3 WorldAt(vec2 uv, float deviceZ)
{
    vec4 clip = vec4(uv * 2.0 - 1.0, deviceZ, 1.0);
    vec4 p = pc.InvViewProj * clip;
    return p.xyz / p.w;
}

// The copy at a point on the screen, bilinear between the four texels round it, clamped to the
// image: it is storage-only, and a sampler on it reads garbage.
vec4 CopyAt(vec2 uv, ivec2 size)
{
    vec2 texel = uv * vec2(size) - 0.5;
    ivec2 base = ivec2(floor(texel));
    vec2 f = texel - vec2(base);
    ivec2 top = size - 1;

    vec4 a = imageLoad(sceneCopy, clamp(base, ivec2(0), top));
    vec4 b = imageLoad(sceneCopy, clamp(base + ivec2(1, 0), ivec2(0), top));
    vec4 c = imageLoad(sceneCopy, clamp(base + ivec2(0, 1), ivec2(0), top));
    vec4 d = imageLoad(sceneCopy, clamp(base + ivec2(1, 1), ivec2(0), top));
    return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
}

// Where the front's shell bends the ray through uv, as an offset on the screen: nothing away from
// the shell, under the ground, behind the scene, or when no front is strong enough to draw.
vec2 RingBend(vec2 uv)
{
    if (pc.CentreUvStrength.z <= 0.0) return vec2(0.0);

    vec3 dir = normalize(WorldAt(uv, 1.0));

    vec3 centre = pc.CentreRadius.xyz;
    float radius = pc.CentreRadius.w;
    float width = pc.CentreUvStrength.w;

    // Where this ray passes nearest the burst, and how near. A ray grazing the shell crosses the
    // most of it, which is where a front bends the light: the rim of the ring, not its face.
    float along = dot(centre, dir);
    if (along <= 0.0) return vec2(0.0);

    vec3 nearest = dir * along;
    float x = (length(centre - nearest) - radius) / max(width, 1.0);
    // Three widths is CloudPass.ShockBandWidths, which skips a front the camera is that far inside.
    if (abs(x) > 3.0) return vec2(0.0);

    // Only what is above the ground; the rest is underground. The up vector's length past one is how
    // far over the ground the burst was, so an air burst's front is a sphere until it reaches it.
    vec3 up = normalize(pc.UpMode.xyz);
    float overGround = max(length(pc.UpMode.xyz) - 1.0, 0.0);
    if (dot(nearest - centre, up) < -(overGround + width)) return vec2(0.0);

    // And only where nothing in the scene stands in front of it.
    float deviceZ = texture(sceneDepth, uv).r;
    float sceneT = deviceZ > 0.0 ? length(WorldAt(uv, deviceZ)) : 1.0e30;
    if (along > sceneT) return vec2(0.0);

    // A lens across the shell: outward on one side of it, inward on the other, nothing at its middle
    // -- the derivative of the shell's density, which is what refraction follows. Scaled by how wide
    // the shell looks from here, so a front far off is a fine line and one close by a heavy one.
    float lens = -2.0 * x * exp(-x * x);
    vec2 outward = uv - pc.CentreUvStrength.xy;
    float spread = length(outward);
    if (spread < 1.0e-5) return vec2(0.0);

    return (outward / spread) * (lens * pc.CentreUvStrength.z * width / along);
}

void main()
{
    ivec2 size = imageSize(sceneColor);
    ivec2 at = ivec2(gl_GlobalInvocationID.xy);
    if (at.x >= size.x || at.y >= size.y) return;

    if (pc.UpMode.w < 0.5)
    {
        imageStore(sceneCopy, at, imageLoad(sceneColor, at));
        return;
    }

    vec2 uv = (vec2(at) + 0.5) / vec2(size);
    vec2 from = uv;
    bool shaking = pc.Shake.w > 0.5;

    // The picture thrown and turned about its centre, and pushed in by as much as it moved so the
    // edge it leaves behind stays off the screen.
    if (shaking)
    {
        float aspect = float(size.x) / float(size.y);
        vec2 c = (uv - 0.5) * vec2(aspect, 1.0);
        float s = sin(pc.Shake.z), k = cos(pc.Shake.z);
        c = vec2(k * c.x - s * c.y, s * c.x + k * c.y);
        c /= 1.0 + 2.0 * (abs(pc.Shake.x) + abs(pc.Shake.y) + abs(pc.Shake.z));
        from = (c + pc.Shake.xy) / vec2(aspect, 1.0) + 0.5;
    }

    vec2 bend = RingBend(uv);
    if (!shaking && bend == vec2(0.0)) return;

    vec4 was = imageLoad(sceneColor, at);
    imageStore(sceneColor, at, vec4(CopyAt(from + bend, size).rgb, was.a));
}
