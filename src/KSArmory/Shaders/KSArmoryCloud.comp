#version 450

// KSA's own atmosphere, through a header this mod writes at load pointing at the player's install:
// shaderc resolves an include against the requesting file, and Core's shader tree and a mod's do
// not meet by any relative path. Ksa/CoreShaderInclude.cs writes it; nothing of the game's is
// copied here.
//
// Set 0 is the engine's GLOBAL set and ComputePipelineWrapper already binds it for every compute
// pass -- so the lighting block and the ambient LUT are in this shader without a descriptor of
// this mod's own. That is the whole of why the real sky costs no plumbing.
//
// The two set indices below are pointed at slots this pass does not use, the way Core's own
// Volumetric.comp does it: the headers declare them, nothing here calls what they declare, and an
// unused declaration binds nothing.
#define SET_TEXTURE 2
#define SET_CLOUD_DATA 3

#include "Content/CoreAtmosphere.glsl"

// This mod's nuclear cloud, evaluated per pixel instead of choreographed as capsules.
//
// Dispatched from a Harmony prefix on SunbloomRenderer.Render - the one point in KSA's frame where
// the scene colour is already in a STORAGE layout and the depth already SAMPLED, both the engine's
// own barriers for its own screen-space volumetric particles, and before bloom and the tonemap. So
// what is written here blooms and is graded with the scene, and no barrier is this mod's to manage.
//
// Bindings follow ComputePipelineWrapper's order: set 1 takes the storage targets first, then the
// depth sampler, then the colour samplers. The same layout Core's Volumetric.comp uses.
//
// EVERYTHING IS CAMERA-RELATIVE. The world is a solar system in doubles; a float metre is hopeless
// at that magnitude, so the burst arrives already differenced against the camera on the CPU and the
// camera sits at the origin here. KSA's Ego frame is a pure translation of the ecliptic, which is
// what makes that exact rather than approximate.

layout (local_size_x = 8, local_size_y = 8) in;

layout (set = 1, binding = 0, Rgba16f) uniform image2D sceneColor;

// Where the clouds go instead of the scene: rgb the light they add, a how much of what is behind
// them still shows, and how far each pixel's cloud is. KSArmoryCloudResolve.comp blends this with
// last frame's and composites it, which is what lets the march dither per frame.
layout (set = 1, binding = 1, Rgba16f) uniform image2D layerColor;
layout (set = 1, binding = 2, R32f) uniform image2D layerDistance;

layout (set = 1, binding = 3) uniform sampler2D sceneDepth;

// The engine's aerial-perspective LUTs, in the order ComputePipelineWrapper takes them: storage
// images first, then every image sampler. The transmittance LUT is not here -- it is already in the
// global set at binding 7, which the wrapper binds for every compute pass.
layout (set = 1, binding = 4) uniform sampler2D aerialRangeLut;
layout (set = 1, binding = 5) uniform sampler3D aerialColorRgbTransmittanceRLut;
layout (set = 1, binding = 6) uniform sampler3D aerialTransmittanceGbLut;

// KSA's own weather clouds as they were drawn this frame, at the cloud renderer's low resolution:
// their light with transmittance in alpha, and how far each pixel's cloud is from the camera in
// kilometres. They write no depth, so without these everything drawn here off the depth buffer is
// drawn in front of every cloud. Stand-ins when clouds are off -- see weatherBound.
layout (set = 1, binding = 7) uniform sampler2D weatherColor;
layout (set = 1, binding = 8) uniform sampler2D weatherDistance;

layout (push_constant) uniform PushConstants
{
    mat4 InvViewProj;      // clip -> camera-relative world
    vec4 AgeStrengthWind;  // x seconds since the burst, y strength (0 draws nothing), zw downwind
    vec4 CentreRadius;     // xyz burst, camera-relative metres; w the sphere that bounds it all
    vec4 FireSun;          // fireball radius, its glow, the heat left in the cloud (the whiteout
                           // on the flash's own dispatch), flags
    vec4 Shape;            // cap centre height, cap radius, cap tube, stem radius
} pc;

// A unit vector back out of two floats. Both directions arrive this way so the whole block fits
// 128 bytes, which is all Vulkan guarantees.
vec3 OctahedralUnpack(vec2 o)
{
    vec3 n = vec3(o.x, o.y, 1.0 - abs(o.x) - abs(o.y));
    if (n.z < 0.0) n.xy = (1.0 - abs(n.yx)) * vec2(n.x >= 0.0 ? 1.0 : -1.0, n.y >= 0.0 ? 1.0 : -1.0);
    return normalize(n);
}

// Value noise and an fBm over it. The point of a raymarched cloud rather than a walked one is that
// the detail is evaluated wherever the ray happens to be, at every scale, instead of being carried
// by however many capsules somebody laid.
float Hash(vec3 p)
{
    p = fract(p * 0.3183099 + vec3(0.71, 0.113, 0.419));
    p *= 17.0;
    return fract(p.x * p.y * p.z * (p.x + p.y + p.z));
}

float Noise(vec3 x)
{
    vec3 i = floor(x);
    vec3 f = fract(x);
    f = f * f * (3.0 - 2.0 * f);

    return mix(mix(mix(Hash(i + vec3(0, 0, 0)), Hash(i + vec3(1, 0, 0)), f.x),
                   mix(Hash(i + vec3(0, 1, 0)), Hash(i + vec3(1, 1, 0)), f.x), f.y),
               mix(mix(Hash(i + vec3(0, 0, 1)), Hash(i + vec3(1, 0, 1)), f.x),
                   mix(Hash(i + vec3(0, 1, 1)), Hash(i + vec3(1, 1, 1)), f.x), f.y), f.z);
}

float Fbm(vec3 p)
{
    float sum = 0.0;
    float amp = 0.5;

    for (int i = 0; i < 4; i++)
    {
        sum += amp * Noise(p);
        p *= 2.03;
        amp *= 0.5;
    }

    return sum;
}

// How far below the cap the fallout hangs, in the cap's own tube radii, and how thick it is against
// the cap above it. Faint: it is what the cloud is losing, not the cloud. On the cap's thickness
// rather than the cloud's size, so an anvil's thin sheet sheds a short fringe, not a wall.
layout (constant_id = 3) const float FalloutReach = 2.3;
layout (constant_id = 4) const float FalloutDensity = 0.30;

// Stands in for "no cap over this sample at all". Any number past the erosion's reach does, and a
// finite one keeps the comparisons below free of an isinf.
const float Nowhere = 1.0e9;

// How far the fallout plume runs downwind and how wide it gets, both as multiples of the burned
// patch's own radius -- so the footprint grows with the warhead rather than being a typed distance.
//
// A DRAWING CHOICE in the same sense as MushroomCloud.DrawnScale. Hazardous deposition from a
// 20 kt burst runs tens of kilometres, which against a two-kilometre patch is fifteen times this
// and leaves the scene entirely. Three puts the far end just outside the frame a burst is watched
// from, which is as much of it as anybody can be shown.
const float PlumeReach = 3.0;
const float PlumeMouth = 0.45;
const float PlumeWidth = 0.75;

// And how dark it goes against the patch, which is less: this is dust that settled, not ground the
// flash burned.
const float PlumeDepth = 1.0;

// How far above the waterline a mark comes back to full strength.
const float SeaMarginMetres = 2.0;

// How much of the ground's own colour the burn takes, at the middle of the mark. Not all of it:
// a scorched hillside is still a lit hillside, and driving it to flat ash removes the relief the
// terrain is drawn with.
layout (constant_id = 15) const float ScorchDepth = 0.85;

// How far the wind turns between the foot of the column and its top.
const float VeerRadians = 0.55;

// The rising thermal, as an ellipsoid of revolution. The torus is the vortex ring around the cap
// and cannot be the cap itself: a torus has a hole on its axis, and the stem stops at the ring's
// own height, so the middle of the top is empty. That reads as a flat slab with a dip in it.
// A mushroom's defining silhouette is a dome that is HIGHEST on the axis with the ring bulging
// out under it, which is these two unioned rather than either alone.
float CapDome(vec2 p, float ringR, float tubeR)
{
    // Centred a little above the ring so the dome rises out of it rather than sitting level.
    vec2 r = vec2(ringR * 1.02, tubeR * 1.75);
    vec2 q = vec2(p.x, p.y - tubeR * 0.35) / r;
    return (length(q) - 1.0) * min(r.x, r.y);
}

// Distance to the ring of the cap's torus. The cap is a vortex ring and this is the one shape a
// stroke of capsules can only approximate: here it is the primitive.
float Torus(vec3 p, float ring, float tube)
{
    vec2 q = vec2(length(p.xz) - ring, p.y);
    return length(q) - tube;
}

// How much wider than the stem its foot spreads at the ground, and over what share of the stem's
// height that falls away to nothing, as an exponential.
layout (constant_id = 1) const float FootFlare = 2.5;
layout (constant_id = 2) const float FootFlareReach = 0.07;

// How wide the stem is at a height, as a fraction of its nominal radius. A column of lifted dust
// is widest where it leaves the ground and necks in as it is drawn up into the cap, and a constant
// radius is the single thing that makes it read as a drainpipe rather than as a column of dirt.
float StemWidthAt(float y, float capH)
{
    if (capH <= 0.0) return 1.0;

    float t = clamp(y / capH, 0.0, 1.0);

    // The flare belongs at the FOOT and nowhere else. Spread over the lower two thirds it is a
    // cone rather than a column, which trades one wrong silhouette for another -- so it is an
    // exponential rather than a ramp: three and a half times the stem at the ground, under twice
    // it a tenth of the way up, and gone by a fifth. That is the concave skirt a column of lifted
    // dust spreads into where the afterwind feeds it along the ground, and the raymarch draws it
    // lit like the rest of the column where particles came out black. It widens again into the
    // cap's underside so the two meet instead of the stem ending inside a wall.
    return 0.92 + (FootFlare * exp(-t / FootFlareReach)) + (0.50 * smoothstep(0.76, 1.0, t));
}

// How far behind KSA's weather a point is, from 0 in front to 1 behind. The renderer gives one
// averaged distance per pixel and it moves a little every frame; cut hard at it, a burst inside the
// deck's depth flips between the two every frame and the weather flickers through it. So it is
// eased over a band that grows with range -- BEHIND that distance only: a band reaching in front of
// it counts the back of a burst standing before a deck as behind the deck, and the burst goes
// transparent.
layout (constant_id = 14) const float WeatherDepthSpread = 0.15;

float BehindWeather(float t, float weatherAt)
{
    if (weatherAt >= 1.0e29) return 0.0;

    float band = max(weatherAt * WeatherDepthSpread, 200.0);
    return smoothstep(weatherAt, weatherAt + band, t);
}

// How much a unit of density dims the light through it, per metre.
layout (constant_id = 16) const float Extinction = 0.022;

// What the pass writes instead of the picture, to look at one term alone: 0 the picture, 1 coverage,
// 2 depth in the cloud, 3 the weather mask, 4 sunlight reaching the cloud, 5 the fireball's share of
// its light. Sim/ShaderTunables.cs names them; a specialization constant, so the picture pays nothing
// for them.
layout (constant_id = 0) const int DebugView = 0;

// Camera-relative world position of a pixel at a given device depth.
vec3 WorldAt(vec2 uv, float deviceZ)
{
    vec4 clip = vec4(uv * 2.0 - 1.0, deviceZ, 1.0);
    vec4 p = pc.InvViewProj * clip;
    return p.xyz / p.w;
}

// The cloud's density at a point given relative to the burst. Pulled out of the march because the
// sun march needs the same answer: a volume that is not asked how thick it is between a sample and
// the light has no self-shadowing, and self-shadowing is most of what makes a cloud read as one.
// The cloud's bulk, with no erosion on it: the torus unioned with the stem and nothing else.
//
// This is what the SHADOW march asks for, and it is four fifths of the cost of the whole pass.
// Four taps at every one of 48 steps is 192 density evaluations a pixel, and running the full
// fBm for each was paying for turbulent detail in a term that is then exponentiated into a
// smooth falloff. A shadow wants to know how much cloud is in the way, not what shape its
// surface is.
// The wind, as the pens lean into it: MushroomCloud.LeanAt, super-linear in height so the foot
// stays over the crater while the cap rides downwind. A column standing exactly vertical is the
// plainest tell that a shape was generated.
vec3 Unlean(vec3 world, vec3 up, float top)
{
    float y = dot(world, up);
    if (top <= 0.0 || y <= 0.0) return world;

    vec3 wind = OctahedralUnpack(pc.AgeStrengthWind.zw);

    float t = clamp(y / top, 0.0, 1.0);

    // Half what MushroomCloud.LeanAt gives the pens. That constant is bounded by the cap having to
    // stay over the column holding it up, and a raymarched stem is thinner than a bundle of nine
    // capsules -- at the full lean the cap rides off the top of it and reads as detached.
    float lean = 0.095 * top * pow(t, 1.4);

    // AND THE WIND TURNS WITH HEIGHT, not only strengthens. Veer is what the Ekman spiral and the
    // thermal wind do between the ground and the tropopause, twenty to sixty degrees over a column
    // this tall -- so a cloud shears into a corkscrew rather than leaning in one flat plane, which
    // is the plainest tell that the wind above a generated one is a single vector.
    //
    // Free: the axis is the local vertical, and the downwind is perpendicular to it already, so
    // the rotation is one sine and cosine against a cross product.
    float veer = VeerRadians * t;
    vec3 side = cross(up, wind);
    vec3 blown = (wind * cos(veer)) + (side * sin(veer));

    // Taken OFF the sample: the shape is upright and the world is leaning, so a point out downwind
    // belongs to a part of the column further up rather than to nothing.
    return world - blown * lean;
}

float Bulk(vec3 leaned, vec3 up)
{
    vec3 world = leaned;
    float y = dot(world, up);
    vec3 p = vec3(length(world - up * y), y, 0.0);

    float capH = pc.Shape.x;
    float ringR = max(pc.Shape.y - pc.Shape.z, pc.Shape.z);
    float tubeR = pc.Shape.z;

    vec3 capP = vec3(p.x, p.y - capH, 0.0);
    float stemR = pc.Shape.w;

    float cap = min(Torus(capP, ringR, tubeR), CapDome(vec2(p.x, p.y - capH), ringR, tubeR));
    float stem = max(p.x - StemWidthAt(p.y, capH) * stemR, p.y - capH);

    // Per feature, for the same reason Density is: a stem normalised by the cap's tube casts a
    // third of the shadow it should, so the cap stops shading the column under it.
    return max(clamp(-cap / max(tubeR * 1.3, 1.0), 0.0, 1.0),
               clamp(-stem / max(stemR * 1.3, 1.0), 0.0, 1.0));
}

// The furthest the two erosion bands can move a surface inward, in the feature's own radii. The
// coarse band runs to about 0.55 of its 1.05 and the fine to 0.15 of its 0.30; this is over both
// with room to spare, because being generous here costs a few samples and being tight drops
// density that should have been there.
const float ErodeReach = 0.80;

// How fast the young cloud churns, as a multiple of the steady roll at the instant of the burst,
// and how quickly that dies away. A fireball rises at hundreds of metres a second at first and slows
// as it entrains air; a roll at the steady rate throughout is a cloud that was born calm.
layout (constant_id = 18) const float ChurnBoost = 5.0;
const float ChurnSeconds = 6.0;

// How far the vortex has turned by an age: the steady rate, plus a fast early one decaying to it.
// The integral rather than rate times age, so the coordinate never runs backwards as it slows.
float RollAngle(float age)
{
    const float RollRadiansPerSecond = 0.22;
    return RollRadiansPerSecond * (age + ChurnBoost * ChurnSeconds * (1.0 - exp(-age / ChurnSeconds)));
}

// How long the fire takes to hollow out of the ball's middle into the ring. The underside is drawn
// up through the centre as the ball starts to rise, so what glowed as a sphere turns into a doughnut
// of fire rolling over on itself.
const float HollowSeconds = 4.0;

float Density(vec3 leaned, vec3 up, float radius, out float fireMask)
{
    fireMask = 0.0;

    vec3 world = Unlean(leaned, up, radius);
    float y = dot(world, up);
    vec3 flat_ = world - up * y;
    vec3 p = vec3(length(flat_), y, 0.0);

    float capH = pc.Shape.x;
    float ringR = max(pc.Shape.y - pc.Shape.z, pc.Shape.z);
    float tubeR = pc.Shape.z;
    float stemR = pc.Shape.w;

    vec3 capP = vec3(p.x, p.y - capH, 0.0);
    float cap = min(Torus(capP, ringR, tubeR), CapDome(vec2(p.x, p.y - capH), ringR, tubeR));
    float stem = max(p.x - StemWidthAt(p.y, capH) * stemR, p.y - capH);

    // The vortex turning over. The billows are already organised on the poloidal angle -- the angle
    // around the ring -- so ADVECTING that angle with time is the circulation itself: up the inside,
    // over the top, down the outside. It costs one subtraction.
    //
    // This is the thing pens could not do. A cursor that keeps everywhere it has been draws a helix
    // when it is rolled, which is why MushroomCloud.Shape.Roll was computed and then never used by
    // anything. A volume has no such problem: nothing here remembers where it was.
    // REJECTED BEFORE ANY NOISE. The erosion below can only pull a surface inward by the coarse
    // band's 1.05 and the fine band's 0.30 of the feature's own radius, so a sample further outside
    // than that cannot come back with density however the noise falls -- this is exact, not an
    // approximation. The fBm it skips is the most expensive thing in this shader and most samples
    // inside the bounding sphere are nowhere near the cloud.
    // FALLOUT, the noise-free half: how far below the cap's own plane this is, and whether there
    // is any cap at this radius to fall from. Asked here rather than below because the rejection
    // is exact and has to stay exact -- a curtain the early-out throws away is a curtain that
    // never draws.
    float drop = (capH - p.y) / max(tubeR * FalloutReach, 1.0);
    float above = (drop > 0.0 && drop < 1.0)
                      ? min(Torus(vec3(p.x, 0.0, 0.0), ringR, tubeR),
                            CapDome(vec2(p.x, 0.0), ringR, tubeR))
                      : Nowhere;

    if (cap > ErodeReach * tubeR && stem > ErodeReach * stemR && above > ErodeReach * tubeR)
        return 0.0;

    float age = pc.AgeStrengthWind.x;
    float around = atan(p.y - capH, p.x - ringR) - RollAngle(age);

    // The coordinate turns about the ring, which is what rolls the cap the way a vortex does:
    // inside rising, over the top, down the outside.
    //
    // Frequency is per CLOUD rather than per metre, so every yield carries the same number of
    // billows -- about two dozen, which is where fBm starts reading as turbulence rather than as a
    // dent. Worley was tried here and is NOT in: docs/NUCLEAR-EFFECT.md has what it did instead.
    //
    // TWO BANDS, and what matters is the amplitude rather than either frequency. A single band at
    // 2.2 tube radii moves the surface further than the tube is thick, which erases the torus
    // outright: the cap stopped reading as a cap and became a blob, and that silhouette is the one
    // shape this volume exists to draw. The coarse band billows, the fine one is surface texture,
    // and together they come to about half what the single band moved.
    // The drift through the noise speeds up with the churn, so the early cloud boils as well as rolls.
    float boil = age * 0.05 + ChurnBoost * 0.05 * ChurnSeconds * (1.0 - exp(-age / ChurnSeconds));
    float coarse = Fbm(world * (26.0 / max(radius, 1.0)) + vec3(0.0, around, boil));
    // ONE octave, not an fBm. This band is surface texture at a single scale, and a second
    // four-octave fBm here is the most expensive line in the shader for detail that is then
    // exponentiated into a soft edge -- it cost 2.6 ms a frame on its own.
    float fine = Noise(world * (78.0 / max(radius, 1.0)) + vec3(around, 0.0, boil * 1.6));

    // EACH FEATURE CARRIES ITS OWN SCALE, for both the erosion and the falloff. Driving the whole
    // cloud off the cap's tube radius works only while everything is about that thick: once the
    // stem is a fifth of the cap rather than a half, a tube-sized erosion is wider than the column
    // it is cutting into and a tube-sized falloff caps its density at a third however deep inside
    // it the sample is. The column came out a wisp with the cap floating over it -- the lollipop,
    // arrived at through the density rather than through the proportions.
    float capErode = ((coarse - 0.42) * 1.05 + (fine - 0.50) * 0.30) * tubeR;
    float stemErode = ((coarse - 0.42) * 1.05 + (fine - 0.50) * 0.30) * stemR;

    float capDensity = clamp(-(cap - capErode) / max(tubeR * 0.85, 1.0), 0.0, 1.0);
    float stemDensity = clamp(-(stem - stemErode) / max(stemR * 0.85, 1.0), 0.0, 1.0);

    float density = max(capDensity, stemDensity);
    density = density * density;

    // WHERE THE CLOUD IS STILL ON FIRE: deep in the cap, in the pockets the noise makes hottest, and
    // hollowing from the whole ball into the ring as it rises. Only a mask here; the heat and the
    // colour are the march's. Deep rather than anywhere, so the shell of smoke over it is what hides
    // it, and the glow comes through only where the erosion has thinned that shell -- which is the
    // orange-through-black-dust every film of a surface burst shows.
    if (pc.FireSun.z > 0.0)
    {
        float deep = smoothstep(0.45, 0.90, capDensity);
        float fromRing = length(vec2(p.x - ringR, p.y - capH)) / max(tubeR, 1.0);
        float ring = 1.0 - smoothstep(0.35, 0.80, fromRing);
        float hollow = smoothstep(0.0, HollowSeconds, age);
        float pockets = smoothstep(0.50, 0.66, coarse);

        fireMask = deep * mix(1.0, ring, hollow) * pockets;
    }

    // FALLOUT: what the cap is shedding, in strands rather than a sheet. A streamer is long and
    // thin for the reason a rain shaft is -- it is falling, and what carves it is drawn out along
    // the fall -- so the noise coordinate is compressed tenfold along the vertical.
    //
    // HUNG OFF THE CAP'S OWN FIELD, measured from the cap's plane and gated by the same erosion
    // the cap is cut with. A curtain under a fixed plane detaches: erosion moves the cap's real
    // underside well inside the torus's analytic one, so the strands start in clear air with a
    // gap above them, and the parts of the rim the noise has eaten away go on shedding from
    // nothing. Starting at the cap's own middle instead makes the two overlap, so the seam is a
    // max between a dense cap and a faint fall rather than a boundary between them.
    if (above < Nowhere)
    {
        float hang = clamp(-(above - capErode) / max(tubeR * 0.85, 1.0), 0.0, 1.0);

        vec3 drawn = world - (up * (dot(world, up) * 0.90));
        float streak = Noise(drawn * (46.0 / max(radius, 1.0)));

        density = max(density, hang * (1.0 - drop)
                                   * clamp((streak - 0.52) * 3.0, 0.0, 1.0) * FalloutDensity);
    }

    return density;
}

// What a unit of the fireball's own glow is worth as light on the cloud. Its Glow peaks near 400
// and the sun term beside it tops out around 2, so this is the number that decides whether a burst
// tints its cloud or blows the frame out.
// How bright the whiteout writes into the scene, which is HDR and not yet tonemapped. Measured
// through KSA's whole post chain at its default exposure by writing known bands here: 0.25 comes
// out as a mid grey (130), 1.0 as 240, and everything from 1.25 up clips to white. So the floor
// sits just under the clip, where the glare's colour still shows, and only the core goes over.
layout (constant_id = 7) const float GlareFloorNits = 1.1;

// How far past that floor the veil is driven at a full whiteout: 2.6 at the peak, over the clip.
layout (constant_id = 9) const float GlareOverexposure = 1.6;
layout (constant_id = 8) const float GlareCoreNits = 3.0;

// The glare's colour away from the burst. Only the core clips to white; where the veil is
// dimmer it shows the light itself, a fireball of a few thousand kelvin yellowed by kilometres
// of air.
const vec3 GlareWarm = vec3(1.00, 0.73, 0.38);
const vec3 GlareHot = vec3(1.00, 0.97, 0.92);

// The angles at which the glare's brightness and its whiteness have fallen by half. Veiling glare
// in an eye or a lens goes roughly as the inverse square of the angle off the source; the colour
// turns more slowly, because it is set by where the channels stop clipping.
layout (constant_id = 10) const float GlareCoreDeg = 6.0;
layout (constant_id = 11) const float GlareWhiteDeg = 20.0;

// How strongly the ball's steady glare veils round it, per unit of its brightness in the
// whiteout's units, and the most it may. Only the core: this is a halo, not the view going white.
layout (constant_id = 12) const float HaloGain = 0.8;
layout (constant_id = 13) const float HaloMost = 0.85;

layout (constant_id = 5) const float FireGain = 0.110;

// How bright the fire in the young cloud's core glows at full heat, in the scene's units: 1.0 comes
// out of KSA's post chain as 240, so this is an orange just over the clip that blooms, and falls
// under it within a couple of seconds as the core cools.
layout (constant_id = 19) const float FireGlowNits = 3.0;

// How black the young cloud starts, as a share of the soot colour, and the e-folding time of its
// clearing. On the rise's clock, which is eightfold compressed: ten seconds here is the minute and
// more a real one stays dirty.
layout (constant_id = 20) const float SootDepth = 0.95;
layout (constant_id = 21) const float SootSeconds = 10.0;
const float SootOpacity = 2.0;

// How strongly the nitrogen oxides tint the cap, and how long they last.
layout (constant_id = 22) const float NoxStrength = 0.70;
layout (constant_id = 23) const float NoxSeconds = 22.0;

// And the most it may contribute at any one sample. The sun term beside it tops out near 2.
layout (constant_id = 6) const float FireCeiling = 6.0;

// Henyey-Greenstein. Smoke scatters forward, so a cloud is brightest looking through it toward the
// sun and darkest with the sun behind you -- which is the cue that says "volume" rather than "fog".
float Phase(float cosTheta, float g)
{
    float gg = g * g;
    float d = 1.0 + gg - 2.0 * g * cosTheta;
    return (1.0 - gg) / (12.566371 * max(d * sqrt(max(d, 1e-4)), 1e-4));
}

void main()
{
    // The target's own size, asked of the image rather than sent: it is the two floats the wind
    // needed, and the block is at Vulkan's guaranteed 128 bytes with nowhere else to take them from.
    ivec2 size = imageSize(sceneColor);

    ivec2 at = ivec2(gl_GlobalInvocationID.xy);

    // A MARK IS DISPATCHED OVER ITS OWN FOOTPRINT, not over the screen, so its workgroups start at
    // an offset. Marks are permanent, so a full-screen dispatch each is a cost that never goes
    // away; the offset rides in the two floats a mark has no use for, having no fireball.
    //
    // Only for a dispatch that is the ground alone: on a cloud's those two floats are the
    // fireball's radius and glow, and on a flash-only one there is nothing to offset.
    if (pc.FireSun.w > 0.0 && !(pc.AgeStrengthWind.y > 0.0 && pc.CentreRadius.w > 0.0))
    {
        at += ivec2(pc.FireSun.xy);
    }

    if (at.x >= size.x || at.y >= size.y) return;
    // THE WHITEOUT, written before anything can turn this pixel away. A burst blinds the whole
    // view rather than the part of it the cloud happens to cover, so it cannot sit behind the
    // bounding sphere.
    //
    // Here rather than as an ImGui overlay because KSA wraps its entire UI pass in if (DrawUI),
    // and both F2 and ScreenshotCapture clear that -- painted there it vanished from every
    // screenshot the harness took, and would have vanished for any player who hid the HUD.
    //
    // Carried by ONE dispatch however many clouds are standing: the pass runs once per cloud and
    // each would otherwise lay its own white over the last.
    //
    // ABOVE the guards below, because a fireball needs no cloud. On a body with no air none is
    // grown, so the pass was dispatched for nothing and an airless burst blinded nobody -- which
    // is backwards, there being no atmosphere there to attenuate it.
    // Only on the flash's own dispatch, which carries no cloud and no mark: on theirs these floats
    // are the fireball and the tile.
    bool flashDispatch = pc.CentreRadius.w <= 0.0 && pc.FireSun.w <= 0.0;
    if (flashDispatch && (pc.FireSun.z > 0.0 || pc.FireSun.x > 0.0))
    {
        vec4 was = imageLoad(sceneColor, at);
        float whiteout = pc.FireSun.z;

        // The burst's direction rides in the cloud centre's floats on this dispatch, and zero
        // means no centre: the glare is then the warm edge everywhere.
        float core = 0.0;
        float white = 0.0;
        if (dot(pc.CentreRadius.xyz, pc.CentreRadius.xyz) > 0.0)
        {
            vec3 ray = normalize(WorldAt((vec2(at) + 0.5) / vec2(size), 1.0));
            float offDeg = degrees(acos(clamp(dot(ray, normalize(pc.CentreRadius.xyz)), -1.0, 1.0)));
            core = 1.0 / (1.0 + (offDeg / GlareCoreDeg) * (offDeg / GlareCoreDeg));
            white = 1.0 / (1.0 + (offDeg / GlareWhiteDeg) * (offDeg / GlareWhiteDeg));
        }

        // White near the burst, and less of it as the flash dies: the recovery tail is the ball
        // cooling as well as the eye adapting.
        vec3 hue = mix(GlareWarm, GlareHot, white * (0.35 + 0.65 * whiteout));
        // Past the clip everywhere at the peak, so the whole view burns out white; as the eye
        // recovers the edge falls under the clip first, which is where the colour shows. Held
        // under the clip throughout, the peak was a see-through gold and read as a weak flash.
        float nits = GlareFloorNits * (1.0 + GlareOverexposure * whiteout * whiteout)
                   + GlareCoreNits * core;

        // The edge veils a little less, so the scene shows there first as the flash recovers.
        float veil = whiteout * (0.95 + 0.05 * core);
        vec3 blinded = mix(was.rgb, hue * nits, veil);

        // AND THE HALO, which outlasts the whiteout: the eye recovers while the ball still burns,
        // and what scatters round it lasts as long as it is bright, in its own colour as it cools.
        vec3 ball = pc.Shape.xyz / max(max(pc.Shape.x, max(pc.Shape.y, pc.Shape.z)), 1e-3);
        float halo = min(pc.FireSun.x * HaloGain, HaloMost) * core;
        blinded = mix(blinded, ball * (0.9 + 1.2 * core), halo);

        imageStore(sceneColor, at, vec4(blinded, was.a));
    }

    // A mark on the ground OUTLIVES the cloud that made it, so the two are separate dispatches and
    // either may arrive without the other: a burst on an airless body burns ground and grows no
    // column at all, and a column is gone in 78 s where a crater is not. Both want the scene point
    // under this pixel and nothing else here does, so the reconstruction below is shared and a
    // dispatch wanting neither leaves now.
    bool wantsScorch = pc.FireSun.w > 0.0;
    bool wantsCloud = pc.AgeStrengthWind.y > 0.0 && pc.CentreRadius.w > 0.0;

    // Three flags on a cloud's dispatch, in its fourth fireball float, summed and negated because
    // positive there means a ground mark: 1 if the column is spray, 2 if there are no weather
    // clouds bound, 4 if it is the first cloud this frame. A mark's dispatch says the second in its
    // shape's second float instead. CloudPass.CloudFlags writes exactly this.
    float cloudFlags = wantsCloud ? -pc.FireSun.w : 0.0;
    bool columnIsWater = mod(cloudFlags, 2.0) > 0.5;
    bool weatherBound = wantsCloud ? (mod(floor(cloudFlags / 2.0), 2.0) < 0.5) : (pc.Shape.y > 0.5);
    bool firstCloud = cloudFlags > 3.5;

    if (!wantsScorch && !wantsCloud) return;

    // The first cloud clears the layer for the frame, everywhere, before anything below can turn
    // the pixel away: the layer is read whole by the resolve.
    if (wantsCloud && firstCloud)
    {
        imageStore(layerColor, at, vec4(0.0, 0.0, 0.0, 1.0));
        imageStore(layerDistance, at, vec4(0.0));
    }

    vec2 uv = (vec2(at) + 0.5) / vec2(size);

    // The ray, and how far the scene lets it go. Reconstructing the scene point from its own depth
    // and the same matrix is what makes the occlusion exact without needing the near and far planes
    // - and reversed Z means the far plane is 0, where a linear reconstruction would want care.
    vec3 far = WorldAt(uv, 1.0);
    vec3 dir = normalize(far);

    float deviceZ = texture(sceneDepth, uv).r;
    float sceneT = deviceZ > 0.0 ? length(WorldAt(uv, deviceZ)) : 1.0e30;

    // The weather cloud along this pixel, as a thin sheet: how far away it is, and how much of
    // what lies behind it gets through. No cloud is infinitely far and entirely clear, which is
    // the whole of what every burst was drawn against before.
    float weatherAt = 1.0e30;
    float weatherClear = 1.0;

    if (weatherBound)
    {
        float cloudKm = textureLod(weatherDistance, uv, 0.0).r;
        float clear = textureLod(weatherColor, uv, 0.0).a;

        if (cloudKm > 0.0 && clear < 0.999)
        {
            weatherAt = cloudKm * 1000.0;
            weatherClear = clamp(clear, 0.0, 1.0);
        }
    }

    // THE WEATHER MASK, over the whole screen: red where KSA's clouds are opaque, green where the
    // burst's centre counts as behind them. Written by the first cloud alone, and no cloud marches.
    if (DebugView == 3 && wantsCloud)
    {
        if (firstCloud)
        {
            float behind = BehindWeather(length(pc.CentreRadius.xyz), weatherAt);
            vec3 mask = vec3(1.0 - weatherClear, behind, weatherAt < 1.0e29 ? 0.25 : 0.0);
            imageStore(layerColor, at, vec4(mask, 0.0));
        }

        return;
    }

    // Bounding sphere. Most pixels leave here, which is the whole of the performance story.
    vec3 toCentre = pc.CentreRadius.xyz;
    // The cloud's own up, DERIVED rather than sent. A burst's local vertical is the way out from
    // the planet's centre, and both that centre and the burst are already here -- so the two floats
    // it used to cost went to the fireball instead, in a block that is at Vulkan's guaranteed 128
    // bytes with nothing spare.
    vec3 up = normalize(toCentre - global.lighting.planetPosition.xyz);

    // THE GROUND THE FIREBALL BURNED, out to the warhead's own lethal radius. That is the number
    // the panel, the overlay and the blast sweep already describe this weapon by, so a stain
    // wanting a radius of its own would be a fourth one for a player to reconcile -- and it is
    // Hopkinson--Cranz like everything else here, so it grows with the cloud rather than against it.
    //
    // Screen space, off the depth the march is about to clip against: the scene point is along this
    // pixel's own ray at the range the depth buffer gives, so the mark follows whatever terrain is
    // under it with no projection of this mod's own and nothing to place in the world.
    //
    // Drawn from its own dispatch and never from the cloud's, which is what lets one mark be drawn
    // exactly once however many clouds stand over it -- a bus's six warheads land 9 mm apart, and
    // six mixes of the same ash onto the same pixels is six times the cost for a darker stain than
    // any of them asked for.
    float scorch = pc.FireSun.w;

    if (wantsScorch && deviceZ > 0.0)
    {
        vec3 burned = (dir * sceneT) - toCentre;
        float above = dot(burned, up);
        float acrossR = length(burned - up * above);

        // THE PLUME. What the ground is left with is not a disc: the flash burns a patch, and then
        // everything the column lifted comes down DOWNWIND of it over the following hours, in a
        // long narrow footprint that is what actually makes ground uninhabitable. A circle is the
        // crater and nothing else.
        //
        // Same wind vector the column leans and sails along, in the same two floats -- computed
        // twice the two could disagree, and a plume at right angles to the column it fell out of
        // is the plainest tell there is.
        vec3 downwind = OctahedralUnpack(pc.AgeStrengthWind.zw);
        // Not "flat": that is a GLSL interpolation qualifier, and the file already carries a
        // flat_ elsewhere for the same reason.
        vec3 ground = burned - up * above;

        float along = dot(ground, downwind);
        float across = length(ground - downwind * along);

        // Reach and half-width as fractions of the burned patch, and the walk along it as 0..1.
        float run = clamp(along / (scorch * PlumeReach), 0.0, 1.0);

        // It LEAVES the crater at something like the crater's own width and widens with the square
        // root of the distance, which is what a puff spreading by diffusion while it travels does.
        // Starting from nothing makes it a point that never gets going: four factors each under
        // one -- a linear fade, a lateral falloff, its own depth and the noise over it -- took the
        // drawn result to about six per cent of the patch beside it, which is invisible.
        float halfWidth = scorch * (PlumeMouth + (PlumeWidth * sqrt(run)));

        // A flat core with a soft edge rather than a linear taper, for the same reason: a taper
        // has one dark line down the middle and nothing either side of it.
        // Flat cores with soft edges. Ramping from the middle outward puts most of the footprint
        // on the ramp rather than in the plume -- measured against a same-camera control, the
        // drawn result was a mean of 12.9 of 255 over the ground it covered, which is real and
        // under what anybody reads as a mark.
        float lateral = 1.0 - smoothstep(0.75, 1.0, across / max(halfWidth, 1.0));
        float fade = 1.0 - smoothstep(0.70, 1.0, run);

        // Nothing upwind of the burst: fallout goes one way. And none at all where there was no air:
        // no column lifted anything, and no wind would carry it.
        float plume = (along > 0.0 && pc.Shape.z < 0.5) ? lateral * fade : 0.0;

        if (acrossR < scorch || plume > 0.0)
        {
            // Broken at the edge rather than drawn as a circle: what burned is what the terrain let
            // the flash reach, so the boundary wanders by a fraction of its own radius.
            float ragged = (acrossR / scorch) + (Fbm(burned * (6.0 / scorch)) - 0.5) * 0.30;

            // Faded with height ABOVE the burst and not with distance from it, so the ground under
            // an airburst still burns while a craft flying through the same radius does not black
            // out. There is no normal here to ask which a surface is.
            // The patch, and the plume beside it. Taken as a MAXIMUM rather than added: where the
            // two overlap near the burst the ground is already as burned as it gets, and a sum
            // there would drive it past ash into a hole.
            float deposit = max(1.0 - smoothstep(0.35, 1.0, ragged),
                                plume * PlumeDepth
                                      * mix(0.55, 1.0, Fbm(burned * (9.0 / scorch))));

            // The height gate is measured against the burned patch and has to tolerate the
            // ground the PLUME crosses, which runs three times further and over whatever relief is
            // there. At a third of the patch it was cutting the footprint off on every low hill.
            float mark = deposit * (1.0 - smoothstep(0.0, scorch * 0.80, max(above, 0.0)));

            // NOT ON THE SEA. What falls on water sinks and spreads rather than staining it, and in
            // KSA's own model there is no dry ground under sea level -- the ocean is everywhere
            // below it -- so a pixel at or under the waterline is water. Measured as the patch's
            // own height over the sea plus this pixel's height over the patch, both small numbers,
            // rather than off the planet's radius, where a float's step is half a metre. Faded
            // over two metres rather than cut, because the ocean's surface is drawn with waves.
            mark *= smoothstep(0.0, SeaMarginMetres, pc.Shape.x + above);

            // And seen through whatever weather is between it and the eye. The ground is the far
            // side of every cloud over it, so this is only ever a dimming, and an opaque deck hides
            // the mark entirely rather than laying a grey disc across its top.
            mark *= mix(1.0, weatherClear, BehindWeather(sceneT, weatherAt));

            if (mark > 0.0)
            {
                vec4 was = imageLoad(sceneColor, at);

                // Desaturated and then darkened rather than multiplied. A multiply leaves grass
                // green and merely dimmer, which reads as shadow; what a flash leaves is ash, and
                // the colour goes before the light does.
                float luma = dot(was.rgb, vec3(0.2126, 0.7152, 0.0722));
                vec3 ash = vec3(luma) * vec3(0.34, 0.30, 0.27);

                imageStore(sceneColor, at, vec4(mix(was.rgb, ash, mark * ScorchDepth), was.a));
            }
        }
    }

    if (!wantsCloud) return;

    float radius = pc.CentreRadius.w;

    // The direction to the sun FROM THE CLOUD, derived rather than sent: the star's position is in
    // the global block and the burst is in the push constant, so this is a subtraction. That freed
    // the float the whiteout needed in a block with nothing spare.
    vec3 sun = normalize(global.lighting.sunPosition.xyz - toCentre);
    float forward = Phase(dot(dir, sun), 0.3);

    float along = dot(toCentre, dir);
    float perpSq = dot(toCentre, toCentre) - along * along;
    float rSq = radius * radius;
    if (perpSq > rSq) return;

    float half_ = sqrt(rSq - perpSq);
    float t0 = max(along - half_, 0.0);
    float t1 = min(along + half_, sceneT);
    if (t1 <= t0) return;

    // Uniform march. The step is the span rather than a fixed metre count, so a cloud fills the
    // same number of samples whether it is two kilometres away or twenty.
    // Raised from 32 with the budget the raymarch freed. Grain is what a dither trades banding for,
    // and the only thing that actually removes it is samples: interleaved gradient noise was tried
    // in its place and is NOT in, because it is built to be resolved by temporal accumulation and
    // there is none here -- a single frame of it is diagonal hatching across the stem.
    const int Steps = 48;
    float dt = (t1 - t0) / float(Steps);

    // Start each ray a fraction of a step in. Fewer steps band, and a dither turns that banding
    // into grain. Moved on every frame by the golden ratio, so the resolve's history averages the
    // grain away; a pattern fixed per pixel is instead a screen door the cloud moves behind.
    float jitter = fract(Hash(vec3(vec2(at), 0.0)) + float(global.camera.frame % 256) * 0.6180340);

    float transmittance = 1.0;
    vec3 scattered = vec3(0.0);

    // Split at the weather sheet: in front of it the burst is seen as it is; behind it, through
    // the cloud. The overall product still drives the early exit and the empty-ray test.
    float clearInFront = 1.0;
    float clearBehind = 1.0;

    // Where along the ray the cloud is, weighted by what each step blocks: what the resolve
    // reprojects this pixel's history through.
    float depthSum = 0.0;
    float depthWeight = 0.0;

    // What the debug views average, weighted the same way. A specialization constant turns them
    // off, so the picture does not carry them.
    float sunSum = 0.0;
    float fireSum = 0.0;

    for (int i = 0; i < Steps; i++)
    {
        vec3 world = dir * (t0 + (float(i) + jitter) * dt) - toCentre;   // relative to the burst

        float fireMask;
        float density = Density(world, up, radius, fireMask);
        vec3 leaned = world;
        if (density <= 0.0) continue;

        // How much cloud is between this sample and the sun. Four taps, spaced out geometrically so
        // the near shadow is resolved and the far one is still felt -- the cap shading its own stem
        // is the single strongest shape cue a mushroom cloud has.
        float toSun = 0.0;
        float step_ = radius * 0.06;
        for (int k = 1; k <= 4; k++)
        {
            toSun += Bulk(Unlean(leaned + sun * (step_ * float(k * k)), up, radius), up) * step_ * float(k);
        }

        // TWO LOBES. The first is direct light surviving the path to this sample; the second is a
        // cheap stand-in for multiple scattering, which is the whole reason a real cloud is bright
        // in its middle rather than black. A single exponential over a path this long is zero
        // however much light is falling on the cloud, and the widened cap made that the dominant
        // term -- the cap went to a dark slab while the thin stem beside it stayed white.
        float sunlight = exp(-toSun * 0.010) + 0.45 * exp(-toSun * 0.0025);
        float fireShare = 0.0;

        // Sun through the cloud, plus a sky ambient. The ambient is not flat: the sky is brighter
        // toward the sun and toward the horizon, and a single number for it is what makes a volume
        // read as a cut-out.
        //
        // KSA's own sky, not an approximation of one: the same call, the same LUT and the same
        // layer the engine lights its weather clouds and its meshes with, so this cloud is lit by
        // the atmosphere everything else in frame is lit by -- at sunrise, at altitude, and on a
        // body whose air is not Earth's, all of which a hand-written tint gets wrong.
        vec3 camRelative = dir * (t0 + (float(i) + jitter) * dt);
        float atmosRadius = global.lighting.planetRadius + global.lighting.atmosphereHeight;

        vec3 sky = GetAmbient(camRelative, global.lighting.planetPosition.xyz,
                              normalize(global.lighting.sunPosition.xyz - camRelative),
                              global.lighting.planetRadius, atmosRadius, ambientLutGlobal,
                              float(global.lighting.atmosphereLutLayer))
                   * global.lighting.sunColor.rgb;

        // Dirty at the bottom and pale at the top. A surface burst's stem is ground it lifted and
        // its cap is condensation, and photographs read as nuclear clouds largely because of that
        // gradient -- one flat albedo for the whole column is the plainest tell of a generated one.
        float upThrough = clamp(dot(world, up) / max(pc.Shape.x, 1.0), 0.0, 1.0);
        //
        // Off the sea there is no dirt to lift. The column is spray and condensation from the foot
        // up, so it starts where the cap already is -- a white column, which is the silhouette
        // every photograph of a test over water has. Flagged negative in the fourth fireball float,
        // which a cloud has no other use for.
        vec3 foot = columnIsWater ? vec3(0.38, 0.38, 0.39) : vec3(0.21, 0.16, 0.11);
        vec3 albedo = mix(foot, vec3(0.36, 0.35, 0.34), smoothstep(0.05, 0.75, upThrough));

        // SOOT, and then the oxides. The young cloud is the ground the ball swallowed, burning:
        // black-brown dust and smoke wrapped round the fire, which a clean pale cloud from the first
        // frame is the plainest tell against. It clears as the cap condenses and the dust settles into
        // the stem. Under it, the reddish brown of the nitrogen oxides the heat made, which outlasts
        // the glow by tens of seconds and is strongest in the cap, where the hottest air went.
        //
        // Off the sea there is no ground to burn, so no soot; the oxides are the air's, and stay.
        float age = pc.AgeStrengthWind.x;
        float soot = columnIsWater ? 0.0 : SootDepth * exp(-age / SootSeconds);
        albedo = mix(albedo, vec3(0.045, 0.036, 0.030), soot);

        float oxides = NoxStrength * smoothstep(0.5, 3.0, age) * exp(-age / NoxSeconds)
                       * smoothstep(0.35, 0.85, upThrough);
        albedo *= mix(vec3(1.0), vec3(1.30, 0.82, 0.55), oxides);
        // The air between the sun and the scene, which is the engine's own answer to both "has the
        // sun set" and "what colour is it now": it goes to nothing on the night side and reddens
        // through a sunset. Core multiplies its sun colour by exactly this in every mesh shader.
        //
        // NOT GetAerialPerspectiveForObjectInAtmosphere's sunToObjectTransmittance, which is the
        // same quantity per-object and better still. Fed the radii reachable here that came back
        // near zero in broad daylight with the sun measured 27 degrees up -- Core passes topRadius,
        // bottomRadius and planetRadius out of an atmosphere UBO this pass does not bind, and
        // something in that parameterisation disagrees. This needs no radii at all.
        vec3 sunReaching = global.lighting.occlusionColor.rgb;

        vec3 lit = albedo * sunlight * forward * 12.0 * sunReaching + sky * albedo;

        // THE BURST LIGHTING THE CLOUD IT IS INSIDE. For the couple of seconds the ball is
        // incandescent it is by far the brightest thing in the scene, and the young cloud is
        // wrapped around it -- lit from outside alone it is a grey pillar at the one moment it
        // should be glowing. Over before the first of the old captures at 3.8 s, which is why this
        // was never missed.
        //
        // Falls off as the inverse square from the ball's SURFACE rather than its centre, so a
        // sample inside it is bounded instead of dividing by nothing. No shadow march toward it:
        // the ray's own accumulated transmittance already darkens the far side, and four more taps
        // a step is the most expensive thing this shader could buy.
        float ballRadius = pc.FireSun.x;
        float ballGlow = pc.FireSun.y;

        if (ballGlow > 0.0 && ballRadius > 0.0)
        {
            // 1/r, not 1/r-squared. Inside a cloud the ball's light is scattered many times before
            // it gets anywhere, which spreads it far more slowly than a vacuum point source -- and
            // the square left the term at a few per cent of the sun's by the time the cloud was
            // 150 m across against a 53 m ball, which is invisible.
            // FROM THE BALL, which sits at the cap's own centre rather than at the burst: the two
            // are one object. Measured from the burst instead, a cloud whose cap has climbed three
            // hundred metres is lit from under its own stem.
            float span = max(length(world - up * pc.Shape.x), ballRadius);
            float fall = ballRadius / span;

            // Hotter is whiter. The ball cools from white through orange and its glow falls as it
            // does, so one term drives the colour and the brightness together.
            // White only at the very top of the dial. Against the glow's own 400 peak the mix sat
            // at 0.96 for the whole luminous phase, so the ball lit its cloud a flat warm white and
            // never looked like a burst at all.
            vec3 hot = mix(vec3(1.00, 0.34, 0.07), vec3(1.00, 0.88, 0.70),
                           clamp(ballGlow / 1100.0, 0.0, 1.0));

            // Bounded, because the ball's own glow runs to the hundreds and a sample sitting on
            // its surface would otherwise white out the frame the burst is drawn into.
            vec3 fire = hot * albedo * min(ballGlow * fall * FireGain, FireCeiling);
            fireShare = dot(fire, vec3(0.2126, 0.7152, 0.0722))
                        / max(dot(lit + fire, vec3(0.2126, 0.7152, 0.0722)), 1e-4);
            lit += fire;
        }

        // THE FIRE ITSELF, glowing rather than lit: the heat left in the core, where the mask says it
        // is. Emission, so it does not go through the albedo -- a sooty cloud reflects the ball's
        // light poorly and still glows where it is burning. Deep red when nearly cold, orange hot.
        float heat = pc.FireSun.z;
        if (heat > 0.0 && fireMask > 0.0)
        {
            vec3 glowing = mix(vec3(0.85, 0.16, 0.03), vec3(1.00, 0.52, 0.16), heat);
            vec3 emitted = glowing * (FireGlowNits * heat * heat * fireMask);
            fireShare = max(fireShare, dot(emitted, vec3(0.2126, 0.7152, 0.0722))
                                       / max(dot(lit + emitted, vec3(0.2126, 0.7152, 0.0722)), 1e-4));
            lit += emitted;
        }

        // Raised with the falloff above: a core that now genuinely reaches full density is worth
        // more optical depth per metre, and this is what separates a cloud from a stain.
        // Soot is black because it absorbs, so the dirty young cloud is also the thicker one: what
        // hides the fire everywhere but the gaps. A pale cloud at the same density lets it through.
        float extinction = density * Extinction * dt * (1.0 + SootOpacity * soot);
        float behindWeather = BehindWeather(t0 + (float(i) + jitter) * dt, weatherAt);

        scattered += transmittance * lit * extinction * mix(1.0, weatherClear, behindWeather);

        float through = exp(-extinction);

        float blocked = transmittance * (1.0 - through);
        depthSum += blocked * (t0 + (float(i) + jitter) * dt);
        depthWeight += blocked;
        sunSum += blocked * sunlight;
        fireSum += blocked * fireShare;

        transmittance *= through;

        clearBehind *= exp(-extinction * behindWeather);
        clearInFront *= exp(-extinction * (1.0 - behindWeather));

        if (transmittance < 0.03) break;
    }

    if (transmittance > 0.999) return;

    // Aerial perspective: what is between the eye and the cloud, washing it toward the sky with
    // range. Without it a cloud two kilometres off is as crisp as one at arm's length, which is the
    // single strongest cue that something is pasted onto a scene rather than standing in it.
    //
    // KSA's own, from its own LUTs, with every scalar out of the global lighting block -- so the
    // cloud is hazed by the same air as the terrain behind it rather than by a curve fitted to look
    // similar. The wrapper does its own ray-sphere work, which is why this needs no intersections.
    vec3 inscatter = vec3(0.0);
    vec3 eyeTransmittance = vec3(1.0);
    vec3 sunTransmittance = vec3(1.0);

    GetAerialPerspectiveForObjectInAtmosphere(
        toCentre, dir, global.lighting.planetPosition.xyz, global.lighting.sunPosition.xyz,
        global.lighting.planetRadius + global.lighting.atmosphereHeight,
        global.lighting.planetRadius, global.lighting.planetRadius,
        global.lighting.sunColor.rgb, aerialRangeLut,
        aerialColorRgbTransmittanceRLut, aerialTransmittanceGbLut, transmittanceLutGlobal,
        float(global.lighting.atmosphereLutLayer),
        inscatter, eyeTransmittance, sunTransmittance);

    // The cloud dimmed by the air in front of it, plus what that air scatters in. Weighted by how
    // much cloud is actually there, so the haze is not laid over pixels the cloud barely covers.
    // How much of the scene still shows. The part of the burst in front of the weather hides the
    // weather and everything behind it; the part behind hides only what the weather lets through,
    // since the cloud's own light is in front of it. Identical to the plain product when there is
    // no cloud, and the whole scene when an opaque one stands in front of all of it.
    float sceneShows = clearInFront * (1.0 - (weatherClear * (1.0 - clearBehind)));

    float covered = 1.0 - sceneShows;
    vec3 body = scattered * eyeTransmittance + inscatter * covered;

    // The strength fades what the cloud BLOCKS as well as what it adds. Scaling only the light it
    // scatters leaves a dissolving cloud dimming toward black while still occluding the sky behind
    // it at full strength, which is a shadow rather than a cloud going away.
    float strength = clamp(pc.AgeStrengthWind.y, 0.0, 1.0);

    // Into the layer, over whatever further cloud is already in it: the clouds are dispatched far
    // to near, so this one's light is added in front and what it lets through dims the rest.
    float lets = mix(1.0, sceneShows, strength);

    vec4 layer = imageLoad(layerColor, at);

    // A DEBUG VIEW in place of the cloud, opaque where there is any: coverage in grey, depth from
    // blue (near side) to red (far), sunlight in grey, and the fireball's share of the light in red.
    if (DebugView != 0)
    {
        float held = max(depthWeight, 1.0e-6);
        float near = length(toCentre) - radius;
        vec3 view = DebugView == 1 ? vec3(covered)
                  : DebugView == 2 ? mix(vec3(0.1, 0.4, 1.0), vec3(1.0, 0.25, 0.05),
                                         clamp((depthSum / held - near) / (2.0 * radius), 0.0, 1.0))
                  : DebugView == 4 ? vec3(sunSum / held / 1.45)
                  : vec3(fireSum / held, 0.0, 0.1);
        float solid = step(0.01, covered);

        imageStore(layerColor, at, vec4(mix(layer.rgb, view, solid), layer.a * (1.0 - solid)));
        return;
    }

    imageStore(layerColor, at, vec4(layer.rgb * lets + body * strength, layer.a * lets));

    if (strength * covered > 0.02 && depthWeight > 0.0)
    {
        imageStore(layerDistance, at, vec4(depthSum / depthWeight));
    }
}
