#version 450

// KSA's own atmosphere, through a header this mod writes at load pointing at the player's install:
// shaderc resolves an include against the requesting file, and Core's shader tree and a mod's do
// not meet by any relative path. Ksa/CoreShaderInclude.cs writes it; nothing of the game's is
// copied here.
//
// Set 0 is the engine's GLOBAL set and ComputePipelineWrapper already binds it for every compute
// pass -- so the lighting block and the ambient LUT are in this shader without a descriptor of
// this mod's own. That is the whole of why the real sky costs no plumbing.
//
// The two set indices below are pointed at slots this pass does not use, the way Core's own
// Volumetric.comp does it: the headers declare them, nothing here calls what they declare, and an
// unused declaration binds nothing.
#define SET_TEXTURE 2
#define SET_CLOUD_DATA 3

#include "CoreAtmosphere.glsl"

// This mod's nuclear cloud, evaluated per pixel instead of choreographed as capsules.
//
// Dispatched from a Harmony prefix on SunbloomRenderer.Render - the one point in KSA's frame where
// the scene colour is already in a STORAGE layout and the depth already SAMPLED, both the engine's
// own barriers for its own screen-space volumetric particles, and before bloom and the tonemap. So
// what is written here blooms and is graded with the scene, and no barrier is this mod's to manage.
//
// Bindings follow ComputePipelineWrapper's order: set 1 binding 0 is the first storage target,
// binding 1 the first depth sampler. The same layout Core's Volumetric.comp uses.
//
// EVERYTHING IS CAMERA-RELATIVE. The world is a solar system in doubles; a float metre is hopeless
// at that magnitude, so the burst arrives already differenced against the camera on the CPU and the
// camera sits at the origin here. KSA's Ego frame is a pure translation of the ecliptic, which is
// what makes that exact rather than approximate.

layout (local_size_x = 8, local_size_y = 8) in;

layout (set = 1, binding = 0, Rgba16f) uniform image2D sceneColor;
layout (set = 1, binding = 1) uniform sampler2D sceneDepth;

// The engine's aerial-perspective LUTs, in the order ComputePipelineWrapper takes them: storage
// image first, then every image sampler. The transmittance LUT is not here -- it is already in the
// global set at binding 7, which the wrapper binds for every compute pass.
layout (set = 1, binding = 2) uniform sampler2D aerialRangeLut;
layout (set = 1, binding = 3) uniform sampler3D aerialColorRgbTransmittanceRLut;
layout (set = 1, binding = 4) uniform sampler3D aerialTransmittanceGbLut;

layout (push_constant) uniform PushConstants
{
    mat4 InvViewProj;      // clip -> camera-relative world
    vec4 AgeStrengthWind;  // x seconds since the burst, y strength (0 draws nothing), zw downwind
    vec4 CentreRadius;     // xyz burst, camera-relative metres; w the sphere that bounds it all
    vec4 UpSun;            // local vertical and sun direction, each packed into two floats
    vec4 Shape;            // cap centre height, cap radius, cap tube, stem radius
} pc;

// A unit vector back out of two floats. Both directions arrive this way so the whole block fits
// 128 bytes, which is all Vulkan guarantees.
vec3 OctahedralUnpack(vec2 o)
{
    vec3 n = vec3(o.x, o.y, 1.0 - abs(o.x) - abs(o.y));
    if (n.z < 0.0) n.xy = (1.0 - abs(n.yx)) * vec2(n.x >= 0.0 ? 1.0 : -1.0, n.y >= 0.0 ? 1.0 : -1.0);
    return normalize(n);
}

// Value noise and an fBm over it. The point of a raymarched cloud rather than a walked one is that
// the detail is evaluated wherever the ray happens to be, at every scale, instead of being carried
// by however many capsules somebody laid.
float Hash(vec3 p)
{
    p = fract(p * 0.3183099 + vec3(0.71, 0.113, 0.419));
    p *= 17.0;
    return fract(p.x * p.y * p.z * (p.x + p.y + p.z));
}

float Noise(vec3 x)
{
    vec3 i = floor(x);
    vec3 f = fract(x);
    f = f * f * (3.0 - 2.0 * f);

    return mix(mix(mix(Hash(i + vec3(0, 0, 0)), Hash(i + vec3(1, 0, 0)), f.x),
                   mix(Hash(i + vec3(0, 1, 0)), Hash(i + vec3(1, 1, 0)), f.x), f.y),
               mix(mix(Hash(i + vec3(0, 0, 1)), Hash(i + vec3(1, 0, 1)), f.x),
                   mix(Hash(i + vec3(0, 1, 1)), Hash(i + vec3(1, 1, 1)), f.x), f.y), f.z);
}

float Fbm(vec3 p)
{
    float sum = 0.0;
    float amp = 0.5;

    for (int i = 0; i < 4; i++)
    {
        sum += amp * Noise(p);
        p *= 2.03;
        amp *= 0.5;
    }

    return sum;
}

// The rising thermal, as an ellipsoid of revolution. The torus is the vortex ring around the cap
// and cannot be the cap itself: a torus has a hole on its axis, and the stem stops at the ring's
// own height, so the middle of the top is empty. That reads as a flat slab with a dip in it.
// A mushroom's defining silhouette is a dome that is HIGHEST on the axis with the ring bulging
// out under it, which is these two unioned rather than either alone.
float CapDome(vec2 p, float ringR, float tubeR)
{
    // Centred a little above the ring so the dome rises out of it rather than sitting level.
    vec2 r = vec2(ringR * 1.02, tubeR * 1.75);
    vec2 q = vec2(p.x, p.y - tubeR * 0.35) / r;
    return (length(q) - 1.0) * min(r.x, r.y);
}

// Distance to the ring of the cap's torus. The cap is a vortex ring and this is the one shape a
// stroke of capsules can only approximate: here it is the primitive.
float Torus(vec3 p, float ring, float tube)
{
    vec2 q = vec2(length(p.xz) - ring, p.y);
    return length(q) - tube;
}

// Camera-relative world position of a pixel at a given device depth.
vec3 WorldAt(vec2 uv, float deviceZ)
{
    vec4 clip = vec4(uv * 2.0 - 1.0, deviceZ, 1.0);
    vec4 p = pc.InvViewProj * clip;
    return p.xyz / p.w;
}

// The cloud's density at a point given relative to the burst. Pulled out of the march because the
// sun march needs the same answer: a volume that is not asked how thick it is between a sample and
// the light has no self-shadowing, and self-shadowing is most of what makes a cloud read as one.
// The cloud's bulk, with no erosion on it: the torus unioned with the stem and nothing else.
//
// This is what the SHADOW march asks for, and it is four fifths of the cost of the whole pass.
// Four taps at every one of 48 steps is 192 density evaluations a pixel, and running the full
// fBm for each was paying for turbulent detail in a term that is then exponentiated into a
// smooth falloff. A shadow wants to know how much cloud is in the way, not what shape its
// surface is.
// The wind, as the pens lean into it: MushroomCloud.LeanAt, super-linear in height so the foot
// stays over the crater while the cap rides downwind. A column standing exactly vertical is the
// plainest tell that a shape was generated.
vec3 Unlean(vec3 world, vec3 up, float top)
{
    float y = dot(world, up);
    if (top <= 0.0 || y <= 0.0) return world;

    vec3 wind = OctahedralUnpack(pc.AgeStrengthWind.zw);
    // Half what MushroomCloud.LeanAt gives the pens. That constant is bounded by the cap having to
    // stay over the column holding it up, and a raymarched stem is thinner than a bundle of nine
    // capsules -- at the full lean the cap rides off the top of it and reads as detached.
    float lean = 0.095 * top * pow(clamp(y / top, 0.0, 1.0), 1.4);

    // Taken OFF the sample: the shape is upright and the world is leaning, so a point out downwind
    // belongs to a part of the column further up rather than to nothing.
    return world - wind * lean;
}

float Bulk(vec3 leaned, vec3 up)
{
    vec3 world = leaned;
    float y = dot(world, up);
    vec3 p = vec3(length(world - up * y), y, 0.0);

    float capH = pc.Shape.x;
    float ringR = max(pc.Shape.y - pc.Shape.z, pc.Shape.z);
    float tubeR = pc.Shape.z;

    vec3 capP = vec3(p.x, p.y - capH, 0.0);
    float stemR = pc.Shape.w;

    float cap = min(Torus(capP, ringR, tubeR), CapDome(vec2(p.x, p.y - capH), ringR, tubeR));
    float stem = max(p.x - stemR, p.y - capH);

    // Per feature, for the same reason Density is: a stem normalised by the cap's tube casts a
    // third of the shadow it should, so the cap stops shading the column under it.
    return max(clamp(-cap / max(tubeR * 1.3, 1.0), 0.0, 1.0),
               clamp(-stem / max(stemR * 1.3, 1.0), 0.0, 1.0));
}

float Density(vec3 leaned, vec3 up, float radius)
{
    vec3 world = Unlean(leaned, up, radius);
    float y = dot(world, up);
    vec3 flat_ = world - up * y;
    vec3 p = vec3(length(flat_), y, 0.0);

    float capH = pc.Shape.x;
    float ringR = max(pc.Shape.y - pc.Shape.z, pc.Shape.z);
    float tubeR = pc.Shape.z;
    float stemR = pc.Shape.w;

    vec3 capP = vec3(p.x, p.y - capH, 0.0);
    float cap = min(Torus(capP, ringR, tubeR), CapDome(vec2(p.x, p.y - capH), ringR, tubeR));
    float stem = max(p.x - stemR, p.y - capH);

    // The vortex turning over. The billows are already organised on the poloidal angle -- the angle
    // around the ring -- so ADVECTING that angle with time is the circulation itself: up the inside,
    // over the top, down the outside. It costs one subtraction.
    //
    // This is the thing pens could not do. A cursor that keeps everywhere it has been draws a helix
    // when it is rolled, which is why MushroomCloud.Shape.Roll was computed and then never used by
    // anything. A volume has no such problem: nothing here remembers where it was.
    const float RollRadiansPerSecond = 0.22;
    float around = atan(p.y - capH, p.x - ringR) - pc.AgeStrengthWind.x * RollRadiansPerSecond;

    // The coordinate turns about the ring, which is what rolls the cap the way a vortex does:
    // inside rising, over the top, down the outside.
    //
    // Frequency is per CLOUD rather than per metre, so every yield carries the same number of
    // billows -- about two dozen, which is where fBm starts reading as turbulence rather than as a
    // dent. Worley was tried here and is NOT in: docs/NUCLEAR-EFFECT.md has what it did instead.
    //
    // TWO BANDS, and what matters is the amplitude rather than either frequency. A single band at
    // 2.2 tube radii moves the surface further than the tube is thick, which erases the torus
    // outright: the cap stopped reading as a cap and became a blob, and that silhouette is the one
    // shape this volume exists to draw. The coarse band billows, the fine one is surface texture,
    // and together they come to about half what the single band moved.
    float coarse = Fbm(world * (26.0 / max(radius, 1.0)) + vec3(0.0, around, pc.AgeStrengthWind.x * 0.05));
    // ONE octave, not an fBm. This band is surface texture at a single scale, and a second
    // four-octave fBm here is the most expensive line in the shader for detail that is then
    // exponentiated into a soft edge -- it cost 2.6 ms a frame on its own.
    float fine = Noise(world * (78.0 / max(radius, 1.0)) + vec3(around, 0.0, pc.AgeStrengthWind.x * 0.08));

    // EACH FEATURE CARRIES ITS OWN SCALE, for both the erosion and the falloff. Driving the whole
    // cloud off the cap's tube radius works only while everything is about that thick: once the
    // stem is a fifth of the cap rather than a half, a tube-sized erosion is wider than the column
    // it is cutting into and a tube-sized falloff caps its density at a third however deep inside
    // it the sample is. The column came out a wisp with the cap floating over it -- the lollipop,
    // arrived at through the density rather than through the proportions.
    float capErode = ((coarse - 0.42) * 1.05 + (fine - 0.50) * 0.30) * tubeR;
    float stemErode = ((coarse - 0.42) * 1.05 + (fine - 0.50) * 0.30) * stemR;

    float capDensity = clamp(-(cap - capErode) / max(tubeR * 0.85, 1.0), 0.0, 1.0);
    float stemDensity = clamp(-(stem - stemErode) / max(stemR * 0.85, 1.0), 0.0, 1.0);

    float density = max(capDensity, stemDensity);
    return density * density;
}

// Henyey-Greenstein. Smoke scatters forward, so a cloud is brightest looking through it toward the
// sun and darkest with the sun behind you -- which is the cue that says "volume" rather than "fog".
float Phase(float cosTheta, float g)
{
    float gg = g * g;
    float d = 1.0 + gg - 2.0 * g * cosTheta;
    return (1.0 - gg) / (12.566371 * max(d * sqrt(max(d, 1e-4)), 1e-4));
}

void main()
{
    // The target's own size, asked of the image rather than sent: it is the two floats the wind
    // needed, and the block is at Vulkan's guaranteed 128 bytes with nowhere else to take them from.
    ivec2 size = imageSize(sceneColor);

    ivec2 at = ivec2(gl_GlobalInvocationID.xy);
    if (at.x >= size.x || at.y >= size.y) return;
    if (pc.AgeStrengthWind.y <= 0.0 || pc.CentreRadius.w <= 0.0) return;

    vec2 uv = (vec2(at) + 0.5) / vec2(size);

    // The ray, and how far the scene lets it go. Reconstructing the scene point from its own depth
    // and the same matrix is what makes the occlusion exact without needing the near and far planes
    // - and reversed Z means the far plane is 0, where a linear reconstruction would want care.
    vec3 far = WorldAt(uv, 1.0);
    vec3 dir = normalize(far);

    float deviceZ = texture(sceneDepth, uv).r;
    float sceneT = deviceZ > 0.0 ? length(WorldAt(uv, deviceZ)) : 1.0e30;

    // Bounding sphere. Most pixels leave here, which is the whole of the performance story.
    vec3 toCentre = pc.CentreRadius.xyz;
    float radius = pc.CentreRadius.w;
    vec3 up = OctahedralUnpack(pc.UpSun.xy);
    vec3 sun = OctahedralUnpack(pc.UpSun.zw);
    float forward = Phase(dot(dir, sun), 0.3);

    float along = dot(toCentre, dir);
    float perpSq = dot(toCentre, toCentre) - along * along;
    float rSq = radius * radius;
    if (perpSq > rSq) return;

    float half_ = sqrt(rSq - perpSq);
    float t0 = max(along - half_, 0.0);
    float t1 = min(along + half_, sceneT);
    if (t1 <= t0) return;

    // Uniform march. The step is the span rather than a fixed metre count, so a cloud fills the
    // same number of samples whether it is two kilometres away or twenty.
    // Raised from 32 with the budget the raymarch freed. Grain is what a dither trades banding for,
    // and the only thing that actually removes it is samples: interleaved gradient noise was tried
    // in its place and is NOT in, because it is built to be resolved by temporal accumulation and
    // there is none here -- a single frame of it is diagonal hatching across the stem.
    const int Steps = 48;
    float dt = (t1 - t0) / float(Steps);

    // Start each ray a fraction of a step in. Fewer steps band, and a dither turns that banding
    // into grain, which is what makes 32 steps affordable where 48 were not.
    //
    // FIXED PER PIXEL, never per frame. Carrying the age in here re-randomises every pixel every
    // frame, and with nothing accumulating across frames to resolve it that is not a dither, it is
    // white noise at frame rate -- reported from play as hard flickering. A stable pattern bands
    // in the same place every frame, which the eye reads as texture.
    float jitter = Hash(vec3(vec2(at), 0.0));

    float transmittance = 1.0;
    vec3 scattered = vec3(0.0);

    for (int i = 0; i < Steps; i++)
    {
        vec3 world = dir * (t0 + (float(i) + jitter) * dt) - toCentre;   // relative to the burst

        float density = Density(world, up, radius);
        vec3 leaned = world;
        if (density <= 0.0) continue;

        // How much cloud is between this sample and the sun. Four taps, spaced out geometrically so
        // the near shadow is resolved and the far one is still felt -- the cap shading its own stem
        // is the single strongest shape cue a mushroom cloud has.
        float toSun = 0.0;
        float step_ = radius * 0.06;
        for (int k = 1; k <= 4; k++)
        {
            toSun += Bulk(Unlean(leaned + sun * (step_ * float(k * k)), up, radius), up) * step_ * float(k);
        }

        // TWO LOBES. The first is direct light surviving the path to this sample; the second is a
        // cheap stand-in for multiple scattering, which is the whole reason a real cloud is bright
        // in its middle rather than black. A single exponential over a path this long is zero
        // however much light is falling on the cloud, and the widened cap made that the dominant
        // term -- the cap went to a dark slab while the thin stem beside it stayed white.
        float sunlight = exp(-toSun * 0.010) + 0.45 * exp(-toSun * 0.0025);

        // Sun through the cloud, plus a sky ambient. The ambient is not flat: the sky is brighter
        // toward the sun and toward the horizon, and a single number for it is what makes a volume
        // read as a cut-out.
        //
        // KSA's own sky, not an approximation of one: the same call, the same LUT and the same
        // layer the engine lights its weather clouds and its meshes with, so this cloud is lit by
        // the atmosphere everything else in frame is lit by -- at sunrise, at altitude, and on a
        // body whose air is not Earth's, all of which a hand-written tint gets wrong.
        vec3 camRelative = dir * (t0 + (float(i) + jitter) * dt);
        float atmosRadius = global.lighting.planetRadius + global.lighting.atmosphereHeight;

        vec3 sky = GetAmbient(camRelative, global.lighting.planetPosition.xyz,
                              normalize(global.lighting.sunPosition.xyz - camRelative),
                              global.lighting.planetRadius, atmosRadius, ambientLutGlobal,
                              float(global.lighting.atmosphereLutLayer))
                   * global.lighting.sunColor.rgb;

        vec3 albedo = vec3(0.30, 0.26, 0.21);
        vec3 lit = albedo * sunlight * forward * 12.0 + sky * albedo;

        // Raised with the falloff above: a core that now genuinely reaches full density is worth
        // more optical depth per metre, and this is what separates a cloud from a stain.
        float extinction = density * 0.022 * dt;
        scattered += transmittance * lit * extinction;
        transmittance *= exp(-extinction);

        if (transmittance < 0.03) break;
    }

    if (transmittance > 0.999) return;

    // Aerial perspective: what is between the eye and the cloud, washing it toward the sky with
    // range. Without it a cloud two kilometres off is as crisp as one at arm's length, which is the
    // single strongest cue that something is pasted onto a scene rather than standing in it.
    //
    // KSA's own, from its own LUTs, with every scalar out of the global lighting block -- so the
    // cloud is hazed by the same air as the terrain behind it rather than by a curve fitted to look
    // similar. The wrapper does its own ray-sphere work, which is why this needs no intersections.
    vec3 inscatter = vec3(0.0);
    vec3 eyeTransmittance = vec3(1.0);
    vec3 sunTransmittance = vec3(1.0);

    GetAerialPerspectiveForObjectInAtmosphere(
        toCentre, dir, global.lighting.planetPosition.xyz, global.lighting.sunPosition.xyz,
        global.lighting.planetRadius + global.lighting.atmosphereHeight,
        global.lighting.planetRadius, global.lighting.planetRadius,
        global.lighting.sunColor.rgb, aerialRangeLut,
        aerialColorRgbTransmittanceRLut, aerialTransmittanceGbLut, transmittanceLutGlobal,
        float(global.lighting.atmosphereLutLayer),
        inscatter, eyeTransmittance, sunTransmittance);

    // The cloud dimmed by the air in front of it, plus what that air scatters in. Weighted by how
    // much cloud is actually there, so the haze is not laid over pixels the cloud barely covers.
    float covered = 1.0 - transmittance;
    vec3 body = scattered * eyeTransmittance + inscatter * covered;

    vec4 c = imageLoad(sceneColor, at);
    vec3 mixed = c.rgb * transmittance + body * pc.AgeStrengthWind.y;
    imageStore(sceneColor, at, vec4(mixed, c.a));
}
