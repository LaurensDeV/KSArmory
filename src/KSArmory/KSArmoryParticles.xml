    <!--
      Rocket motor plume. Unlike the bursts above this one is held open while the round burns and
      handed back at burnout, so its spawn mode is Endless rather than Burst.

      InheritVelocity is the setting that makes it a plume rather than a string of beads. A round
      at 840 m/s covers 14 m between frames, and particles left at rest in the world would spawn
      as a dotted line the round runs away from; carrying the emitter's velocity, they trail it.
      Core's own ThrusterSparks sets the same flag for the same reason.

      Short-lived and SMALL: this is the flame at a 127 mm nozzle, not a fireball. Core's own
      ThrusterSparks runs particles of 1-3 cm; anything approaching the body's own diameter stops
      reading as exhaust and starts hiding the round, which is what the chase camera looks at.
      A long lifespan on something moving this fast also draws a streak kilometres long.

      GravityStrength is zero and says so, because it defaults to 1 - see the note at the top of
      this file. Exhaust that falls looks like the motor stopped.
    -->
    <ParticleEmitter Id="KSArmoryMotorPlume">
        <MaxParticles Value="64" />
        <Mesh Id="ParticleSphere"/>
        <Renderer>SimpleColor</Renderer>
        <Updaters>SimpleMovement</Updaters>
        <Updaters>ShrinkOverLifetime</Updaters>
        <Updaters>HueShift</Updaters>
        <Updaters>ModelMatrix</Updaters>
        <Updaters>Age</Updaters>
        <SpawnMode>Endless</SpawnMode>
        <EmitterSpawnLogic>Sphere</EmitterSpawnLogic>
        <EmitterSize Value="0.05"/>
        <EmitterExtents X="0.04" Y="0" Z="0"/>
        <SpawnRate Value="90"/>
        <Force X="0" Y="0" Z="0" />
        <InheritVelocity Value="true"/>
        <GravityStrength Value="0.0"/>
        <ParticleColor X="12" Y="6" Z="2" W="1"/>
        <ParticleColorShift X="0.35" Y="0.2" Z="0"/>
        <ParticleLifespan X="0.05" Y="0.14"/>
        <ParticleSpawnLogic>ScatterFromCenter</ParticleSpawnLogic>
        <ParticleSize X="0.05" Y="0.14"/>
        <ParticleVelocity X="2.5" Y="2.5" Z="2.5"/>
        <ParticleVelocityShift Value="0.7"/>
        <ParticleExtra X="0.5" Y="0" Z="0" W="0"/>
    </ParticleEmitter>
