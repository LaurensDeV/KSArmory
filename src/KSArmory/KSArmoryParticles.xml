<?xml version="1.0" encoding="utf-8"?>
<!--
  Warhead effects. Modelled on Core's ParticleEmitterAssets.xml, which is the only documentation
  this format has.

  THERE ARE TWO OF EVERYTHING, and the reason is not stylistic. The Volumetric renderer is KSA's
  screen-space particle renderer, and ParticleSystem.WriteCommandsColorTranslucent only issues its
  draw commands when GameSettings.Graphics.ScreenSpaceParticles is on - which defaults to OFF. A
  volumetric emitter therefore resolves, acquires, registers, spawns, ages and draws absolutely
  nothing on a default install. Detonation picks the variant that will actually render.

  Volumetric is worth the trouble where it works: SimpleColor draws each particle as a solid mesh,
  so a cloud of them reads as a heap of balls however it is coloured, while Volumetric at a low
  Opacity accumulates into density where particles overlap.

  Colour components above 1 are deliberate - Core's ThrusterSparks runs at 15/11/6 - because the
  renderer is HDR and that is what makes a fireball bloom rather than read as flat orange paint.

  ParticleSpawnLogic is radial, never Fountain. Fountain builds a cone about the emitter's local
  +X, and a burst placed in a body-fixed frame has its model matrix forced to identity - so that
  +X would be a fixed direction in the world and every explosion would spray the same way whatever
  blew up. ScatterFromCenter and MoveAwayFromCenter take their direction from each particle's own
  offset from the centre, so they need no orientation to be correct.

  GravityStrength is set on every stage, and it must be: it defaults to 1, so anything that does
  not say otherwise falls at full local gravity. That is right for debris and wrong for everything
  else - a fireball that falls looks like it ended early because it drops out of view, and smoke
  that falls sinks into the ground within a second.

  No InheritVelocity: these hang on a celestial with no vehicle, so there is nothing to inherit
  from and the setting could only mislead whoever reads it next.
-->
<Assets>
    <!-- ============ shared stages, composed by Id the way Core does ============ -->

    <!-- Fragments. The one stage that should be discrete, and the one that should arc. -->
    <ParticleEmitter Id="KSArmoryFragments">
        <MaxParticles Value="96" />
        <Mesh Id="ParticleSphere"/>
        <Renderer>SimpleColor</Renderer>
        <Updaters>SimpleMovement</Updaters>
        <Updaters>ShrinkOverLifetime</Updaters>
        <Updaters>HueShift</Updaters>
        <Updaters>ModelMatrix</Updaters>
        <Updaters>Age</Updaters>
        <SpawnMode>Burst</SpawnMode>
        <EmitterSpawnLogic>Sphere</EmitterSpawnLogic>
        <EmitterSize Value="1.5"/>
        <EmitterExtents X="0.6" Y="0" Z="0"/>
        <SpawnRate Value="96"/>
        <Force X="0" Y="0" Z="0" />
        <GravityStrength Value="0.6"/>
        <ParticleColor X="7" Y="2.4" Z="0.4" W="1"/>
        <ParticleColorShift X="0.5" Y="0.3" Z="0"/>
        <ParticleLifespan X="1.8" Y="4.5"/>
        <ParticleSpawnLogic>MoveAwayFromCenter</ParticleSpawnLogic>
        <ParticleSize X="0.1" Y="0.35"/>
        <ParticleVelocity X="60" Y="60" Z="60"/>
        <ParticleVelocityShift Value="1"/>
        <ParticleExtra X="0.55" Y="0" Z="0" W="0"/>
        <ParticleAngularVelocity X="9" Y="9" Z="9"/>
    </ParticleEmitter>

    <!-- Burning gas, volumetric. Only renders with screen-space particles on. -->
    <ParticleEmitter Id="KSArmoryFireVolumetric">
        <MaxParticles Value="72" />
        <Mesh Id="ParticleSphere"/>
        <Renderer>Volumetric</Renderer>
        <Updaters>SimpleMovement</Updaters>
        <Updaters>GrowOverLifetime</Updaters>
        <Updaters>HueShift</Updaters>
        <Updaters>ModelMatrix</Updaters>
        <Updaters>Age</Updaters>
        <SpawnMode>Burst</SpawnMode>
        <EmitterSpawnLogic>Sphere</EmitterSpawnLogic>
        <EmitterSize Value="2.5"/>
        <EmitterExtents X="1" Y="0" Z="0"/>
        <SpawnRate Value="72"/>
        <Force X="0" Y="0" Z="0" />
        <GravityStrength Value="-0.05"/>
        <EmitterExtra X="0.1" Y="0.01" Z="0" W="0"/>
        <Opacity Value="0.22"/>
        <ParticleColor X="6" Y="2" Z="0.3" W="1"/>
        <ParticleColorShift X="0.4" Y="0.2" Z="0"/>
        <ParticleLifespan X="1.2" Y="2.8"/>
        <ParticleSpawnLogic>ScatterFromCenter</ParticleSpawnLogic>
        <ParticleSize X="1.5" Y="3.5"/>
        <ParticleVelocity X="9" Y="9" Z="9"/>
        <ParticleVelocityShift Value="0.9"/>
        <ParticleExtra X="0.7" Y="0" Z="0" W="0"/>
    </ParticleEmitter>

    <!-- Smoke, volumetric. Buoyant and growing: a cloud spreads as it cools. -->
    <ParticleEmitter Id="KSArmorySmokeVolumetric">
        <MaxParticles Value="64" />
        <Mesh Id="ParticleSphere"/>
        <Renderer>Volumetric</Renderer>
        <Updaters>SimpleMovement</Updaters>
        <Updaters>GrowOverLifetime</Updaters>
        <Updaters>ModelMatrix</Updaters>
        <Updaters>Age</Updaters>
        <SpawnMode>Burst</SpawnMode>
        <EmitterSpawnLogic>Sphere</EmitterSpawnLogic>
        <EmitterSize Value="3"/>
        <EmitterExtents X="1" Y="0" Z="0"/>
        <SpawnRate Value="64"/>
        <Force X="0" Y="0" Z="0" />
        <GravityStrength Value="-0.12"/>
        <EmitterExtra X="0.1" Y="0.01" Z="0" W="0"/>
        <Opacity Value="0.05"/>
        <ParticleColor X="0.30" Y="0.26" Z="0.24" W="1"/>
        <ParticleLifespan X="4.0" Y="8.0"/>
        <ParticleSpawnLogic>ScatterFromCenter</ParticleSpawnLogic>
        <ParticleSize X="2.0" Y="5.0"/>
        <ParticleVelocity X="4" Y="4" Z="4"/>
        <ParticleVelocityShift Value="0.9"/>
        <ParticleExtra X="0.8" Y="0" Z="0" W="0"/>
    </ParticleEmitter>

    <!--
      Smoke without the volumetric renderer. Many more, much smaller and much dimmer than the
      volumetric version: overlapping small spheres are the only way to approximate density when
      the renderer will not do it, and large ones would be the heap of balls this is avoiding.
    -->
    <ParticleEmitter Id="KSArmorySmokeSolid">
        <MaxParticles Value="150" />
        <Mesh Id="ParticleSphere"/>
        <Renderer>SimpleColor</Renderer>
        <Updaters>SimpleMovement</Updaters>
        <Updaters>GrowOverLifetime</Updaters>
        <Updaters>HueShift</Updaters>
        <Updaters>ModelMatrix</Updaters>
        <Updaters>Age</Updaters>
        <SpawnMode>Burst</SpawnMode>
        <EmitterSpawnLogic>Sphere</EmitterSpawnLogic>
        <EmitterSize Value="3.5"/>
        <EmitterExtents X="1" Y="0" Z="0"/>
        <SpawnRate Value="150"/>
        <Force X="0" Y="0" Z="0" />
        <GravityStrength Value="-0.12"/>
        <ParticleColor X="0.22" Y="0.19" Z="0.17" W="1"/>
        <ParticleColorShift X="0.06" Y="0.04" Z="0"/>
        <ParticleLifespan X="4.0" Y="8.0"/>
        <ParticleSpawnLogic>ScatterFromCenter</ParticleSpawnLogic>
        <ParticleSize X="0.6" Y="1.8"/>
        <ParticleVelocity X="4" Y="4" Z="4"/>
        <ParticleVelocityShift Value="0.9"/>
        <ParticleExtra X="0.8" Y="0" Z="0" W="0"/>
        <ParticleAngularVelocity X="1.2" Y="1.2" Z="1.2"/>
    </ParticleEmitter>

    <!-- ============ the two fireballs ============ -->
    <!--
      Both are the same flash - the stage that blooms, and the one that must not be volumetric
      because bloom is what it is for - with different bodies hung off it.
    -->

    <ParticleEmitter Id="KSArmoryFireball">
        <MaxParticles Value="48" />
        <Mesh Id="ParticleSphere"/>
        <Renderer>SimpleColor</Renderer>
        <Updaters>SimpleMovement</Updaters>
        <Updaters>GrowOnSpawn</Updaters>
        <Updaters>ShrinkOverLifetime</Updaters>
        <Updaters>HueShift</Updaters>
        <Updaters>ModelMatrix</Updaters>
        <Updaters>Age</Updaters>
        <SpawnMode>Burst</SpawnMode>
        <EmitterSpawnLogic>Sphere</EmitterSpawnLogic>
        <EmitterSize Value="2"/>
        <EmitterExtents X="1" Y="0" Z="0"/>
        <SpawnRate Value="48"/>
        <Force X="0" Y="0" Z="0" />
        <GravityStrength Value="0.0"/>
        <ParticleColor X="22" Y="10" Z="3" W="1"/>
        <ParticleColorShift X="0.3" Y="0.15" Z="0"/>
        <ParticleLifespan X="0.25" Y="0.7"/>
        <ParticleSpawnLogic>ScatterFromCenter</ParticleSpawnLogic>
        <ParticleSize X="0.7" Y="2.0"/>
        <ParticleVelocity X="16" Y="16" Z="16"/>
        <ParticleVelocityShift Value="0.8"/>
        <ParticleExtra X="0.55" Y="0" Z="0" W="0"/>
        <ParticleAngularVelocity X="4" Y="4" Z="4"/>

        <ParticleEmitters Id="KSArmoryFireVolumetric"/>
        <ParticleEmitters Id="KSArmoryFragments"/>
        <ParticleEmitters Id="KSArmorySmokeVolumetric"/>
    </ParticleEmitter>

    <ParticleEmitter Id="KSArmoryFireballSolid">
        <MaxParticles Value="48" />
        <Mesh Id="ParticleSphere"/>
        <Renderer>SimpleColor</Renderer>
        <Updaters>SimpleMovement</Updaters>
        <Updaters>GrowOnSpawn</Updaters>
        <Updaters>ShrinkOverLifetime</Updaters>
        <Updaters>HueShift</Updaters>
        <Updaters>ModelMatrix</Updaters>
        <Updaters>Age</Updaters>
        <SpawnMode>Burst</SpawnMode>
        <EmitterSpawnLogic>Sphere</EmitterSpawnLogic>
        <EmitterSize Value="2"/>
        <EmitterExtents X="1" Y="0" Z="0"/>
        <SpawnRate Value="48"/>
        <Force X="0" Y="0" Z="0" />
        <GravityStrength Value="0.0"/>
        <ParticleColor X="22" Y="10" Z="3" W="1"/>
        <ParticleColorShift X="0.3" Y="0.15" Z="0"/>
        <ParticleLifespan X="0.25" Y="0.7"/>
        <ParticleSpawnLogic>ScatterFromCenter</ParticleSpawnLogic>
        <ParticleSize X="0.7" Y="2.0"/>
        <ParticleVelocity X="16" Y="16" Z="16"/>
        <ParticleVelocityShift Value="0.8"/>
        <ParticleExtra X="0.55" Y="0" Z="0" W="0"/>
        <ParticleAngularVelocity X="4" Y="4" Z="4"/>

        <ParticleEmitters Id="KSArmoryFragments"/>
        <ParticleEmitters Id="KSArmorySmokeSolid"/>
    </ParticleEmitter>

    <!-- ============ the two airbursts ============ -->
    <!--
      A round that fused but did not kill: a flash and a wisp. Telling a near miss from a hit by
      eye is most of what watching an engagement is for, so neither must grow into a small
      fireball.
    -->

    <ParticleEmitter Id="KSArmoryAirburstWisp">
        <MaxParticles Value="28" />
        <Mesh Id="ParticleSphere"/>
        <Renderer>Volumetric</Renderer>
        <Updaters>SimpleMovement</Updaters>
        <Updaters>GrowOverLifetime</Updaters>
        <Updaters>ModelMatrix</Updaters>
        <Updaters>Age</Updaters>
        <SpawnMode>Burst</SpawnMode>
        <EmitterSpawnLogic>Sphere</EmitterSpawnLogic>
        <EmitterSize Value="1.5"/>
        <EmitterExtents X="0.6" Y="0" Z="0"/>
        <SpawnRate Value="28"/>
        <Force X="0" Y="0" Z="0" />
        <GravityStrength Value="-0.1"/>
        <EmitterExtra X="0.1" Y="0.01" Z="0" W="0"/>
        <Opacity Value="0.04"/>
        <ParticleColor X="0.35" Y="0.32" Z="0.30" W="1"/>
        <ParticleLifespan X="2.0" Y="4.0"/>
        <ParticleSpawnLogic>ScatterFromCenter</ParticleSpawnLogic>
        <ParticleSize X="1.0" Y="2.2"/>
        <ParticleVelocity X="3" Y="3" Z="3"/>
        <ParticleVelocityShift Value="0.9"/>
        <ParticleExtra X="0.8" Y="0" Z="0" W="0"/>
    </ParticleEmitter>

    <ParticleEmitter Id="KSArmoryAirburstWispSolid">
        <MaxParticles Value="60" />
        <Mesh Id="ParticleSphere"/>
        <Renderer>SimpleColor</Renderer>
        <Updaters>SimpleMovement</Updaters>
        <Updaters>GrowOverLifetime</Updaters>
        <Updaters>HueShift</Updaters>
        <Updaters>ModelMatrix</Updaters>
        <Updaters>Age</Updaters>
        <SpawnMode>Burst</SpawnMode>
        <EmitterSpawnLogic>Sphere</EmitterSpawnLogic>
        <EmitterSize Value="1.8"/>
        <EmitterExtents X="0.6" Y="0" Z="0"/>
        <SpawnRate Value="60"/>
        <Force X="0" Y="0" Z="0" />
        <GravityStrength Value="-0.1"/>
        <ParticleColor X="0.28" Y="0.26" Z="0.24" W="1"/>
        <ParticleColorShift X="0.05" Y="0.04" Z="0"/>
        <ParticleLifespan X="2.0" Y="4.0"/>
        <ParticleSpawnLogic>ScatterFromCenter</ParticleSpawnLogic>
        <ParticleSize X="0.35" Y="0.9"/>
        <ParticleVelocity X="3" Y="3" Z="3"/>
        <ParticleVelocityShift Value="0.9"/>
        <ParticleExtra X="0.8" Y="0" Z="0" W="0"/>
        <ParticleAngularVelocity X="1.2" Y="1.2" Z="1.2"/>
    </ParticleEmitter>

    <ParticleEmitter Id="KSArmoryAirburst">
        <MaxParticles Value="40" />
        <Mesh Id="ParticleSphere"/>
        <Renderer>SimpleColor</Renderer>
        <Updaters>SimpleMovement</Updaters>
        <Updaters>GrowOnSpawn</Updaters>
        <Updaters>ShrinkOverLifetime</Updaters>
        <Updaters>HueShift</Updaters>
        <Updaters>ModelMatrix</Updaters>
        <Updaters>Age</Updaters>
        <SpawnMode>Burst</SpawnMode>
        <EmitterSpawnLogic>Sphere</EmitterSpawnLogic>
        <EmitterSize Value="1.2"/>
        <EmitterExtents X="0.6" Y="0" Z="0"/>
        <SpawnRate Value="40"/>
        <Force X="0" Y="0" Z="0" />
        <GravityStrength Value="0.0"/>
        <ParticleColor X="5" Y="4" Z="3" W="1"/>
        <ParticleColorShift X="0.2" Y="0.2" Z="0"/>
        <ParticleLifespan X="0.4" Y="1.0"/>
        <ParticleSpawnLogic>ScatterFromCenter</ParticleSpawnLogic>
        <ParticleSize X="0.25" Y="0.8"/>
        <ParticleVelocity X="16" Y="16" Z="16"/>
        <ParticleVelocityShift Value="0.8"/>
        <ParticleExtra X="0.55" Y="0" Z="0" W="0"/>
        <ParticleAngularVelocity X="4" Y="4" Z="4"/>

        <ParticleEmitters Id="KSArmoryAirburstWisp"/>
    </ParticleEmitter>

    <ParticleEmitter Id="KSArmoryAirburstSolid">
        <MaxParticles Value="40" />
        <Mesh Id="ParticleSphere"/>
        <Renderer>SimpleColor</Renderer>
        <Updaters>SimpleMovement</Updaters>
        <Updaters>GrowOnSpawn</Updaters>
        <Updaters>ShrinkOverLifetime</Updaters>
        <Updaters>HueShift</Updaters>
        <Updaters>ModelMatrix</Updaters>
        <Updaters>Age</Updaters>
        <SpawnMode>Burst</SpawnMode>
        <EmitterSpawnLogic>Sphere</EmitterSpawnLogic>
        <EmitterSize Value="1.2"/>
        <EmitterExtents X="0.6" Y="0" Z="0"/>
        <SpawnRate Value="40"/>
        <Force X="0" Y="0" Z="0" />
        <GravityStrength Value="0.0"/>
        <ParticleColor X="5" Y="4" Z="3" W="1"/>
        <ParticleColorShift X="0.2" Y="0.2" Z="0"/>
        <ParticleLifespan X="0.4" Y="1.0"/>
        <ParticleSpawnLogic>ScatterFromCenter</ParticleSpawnLogic>
        <ParticleSize X="0.25" Y="0.8"/>
        <ParticleVelocity X="16" Y="16" Z="16"/>
        <ParticleVelocityShift Value="0.8"/>
        <ParticleExtra X="0.55" Y="0" Z="0" W="0"/>
        <ParticleAngularVelocity X="4" Y="4" Z="4"/>

        <ParticleEmitters Id="KSArmoryAirburstWispSolid"/>
    </ParticleEmitter>
</Assets>
